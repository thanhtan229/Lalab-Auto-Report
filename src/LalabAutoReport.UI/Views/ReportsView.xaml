<UserControl x:Class="LalabAutoReport.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LalabAutoReport.UI.ViewModels"
             xmlns:converters="clr-namespace:LalabAutoReport.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1050">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource Tinix.Color.Bg.Body}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Controls & Scope -->
            <RowDefinition Height="Auto"/> <!-- Missing Days Banner -->
            <RowDefinition Height="Auto"/> <!-- KPI Metric Cards -->
            <RowDefinition Height="*"/>    <!-- Data Tables -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP BAR: Mode Selection & Date Pickers -->
        <Border Grid.Row="0" Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Report Mode Radio Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Phạm vi báo cáo:" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="13"/>
                    <RadioButton Content="Theo tháng" IsChecked="True" Checked="ModeMonthly_Checked" Margin="0,0,16,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                    <RadioButton Content="Theo ngày" Checked="ModeDaily_Checked" Margin="0,0,16,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                    <RadioButton Content="Khoảng ngày" Checked="ModeDateRange_Checked" Margin="0,0,16,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                </StackPanel>

                <!-- Date Pickers depending on mode -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <!-- Monthly Mode Controls -->
                    <StackPanel x:Name="MonthlyControls" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding PreviousMonthCommand}" Content="◀" Width="30" Height="34" Style="{StaticResource Tinix.Button.Secondary}" Padding="0"/>
                        <TextBlock Text="{Binding SelectedMonth, StringFormat='Tháng {0}'}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center" Margin="10,0,4,0" FontSize="13"/>
                        <TextBlock Text="/" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Muted}" VerticalAlignment="Center" FontSize="13"/>
                        <TextBlock Text="{Binding SelectedYear}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center" Margin="4,0,10,0" FontSize="13"/>
                        <Button Command="{Binding NextMonthCommand}" Content="▶" Width="30" Height="34" Style="{StaticResource Tinix.Button.Secondary}" Padding="0"/>
                        <Button Command="{Binding CurrentMonthCommand}" Content="Tháng này" Height="34" Style="{StaticResource Tinix.Button.Secondary}" Padding="12,0" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Daily Mode Controls -->
                    <StackPanel x:Name="DailyControls" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Chọn ngày:" Foreground="{StaticResource Tinix.Color.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                        <DatePicker SelectedDate="{Binding SelectedDailyDate}" Height="34" Width="140" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- DateRange Mode Controls -->
                    <StackPanel x:Name="DateRangeControls" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Từ:" Foreground="{StaticResource Tinix.Color.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Height="34" Width="130" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Đến:" Foreground="{StaticResource Tinix.Color.Text.Secondary}" VerticalAlignment="Center" Margin="10,0,6,0" FontSize="13"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Height="34" Width="130" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Refresh / Load Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding LoadReportCommand}" Content="🔄 Làm mới" Height="36" Padding="18,0" Style="{StaticResource Tinix.Button.Primary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MISSING DAYS ALERT BANNER -->
        <Border Grid.Row="1" Background="{StaticResource Tinix.Color.Warning.Bg}" BorderBrush="{StaticResource Tinix.Color.Warning.Border}" BorderThickness="0,0,0,1" Padding="20,12" Visibility="{Binding HasMissingScanDays, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚠️ " FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Phát hiện ngày chưa được quét trong tháng: " FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Warning}" VerticalAlignment="Center" FontSize="13"/>
                    <ItemsControl ItemsSource="{Binding MissingScanDays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FDE68A" CornerRadius="{StaticResource Tinix.Radius.Sm}" Padding="8,2" Margin="4,0" BorderBrush="{StaticResource Tinix.Color.Warning.Border}" BorderThickness="1">
                                    <TextBlock Text="{Binding}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Warning}" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding ScanMissingDaysCommand}" Content="⚡ Quét các ngày còn thiếu" Style="{StaticResource Tinix.Button.Primary}" Padding="16,6" FontSize="12" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"/>
            </Grid>
        </Border>

        <!-- KPI METRICS ROW -->
        <Border Grid.Row="2" Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Metric 1: Revenue (Peach / Warm Orange) -->
                <Border Grid.Column="0" Background="{StaticResource Tinix.Color.Card.Revenue.Bg}" BorderBrush="{StaticResource Tinix.Color.Card.Revenue.Border}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Lg}" Padding="16,14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="DOANH THU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Card.Revenue.Title}"/>
                        <TextBlock Text="{Binding FormattedTotalRevenue}" FontFamily="{StaticResource Tinix.Font.Display}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Card.Revenue.Value}" Margin="0,4,0,0"/>
                        <TextBlock Text="Đơn vị: VND (nguyên)" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                    </StackPanel>
                </Border>

                <!-- Metric 2: Bill Quantity (Sky Blue) -->
                <Border Grid.Column="1" Background="{StaticResource Tinix.Color.Card.Print.Bg}" BorderBrush="{StaticResource Tinix.Color.Card.Print.Border}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Lg}" Padding="16,14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="SẢN LƯỢNG IN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Card.Print.Title}"/>
                        <TextBlock Text="{Binding TotalBillQuantity, StringFormat='{}{0:N0} tấm'}" FontFamily="{StaticResource Tinix.Font.Display}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Card.Print.Value}" Margin="0,4,0,0"/>
                        <TextBlock Text="Tổng ảnh in tính tiền" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                    </StackPanel>
                </Border>

                <!-- Metric 3: Orders (Purple / Lavender) -->
                <Border Grid.Column="2" Background="{StaticResource Tinix.Color.Card.Order.Bg}" BorderBrush="{StaticResource Tinix.Color.Card.Order.Border}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Lg}" Padding="16,14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="ĐƠN HÀNG VẬT LÝ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Card.Order.Title}"/>
                        <TextBlock Text="{Binding TotalOrders, StringFormat='{}{0} đơn'}" FontFamily="{StaticResource Tinix.Font.Display}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Card.Order.Value}" Margin="0,4,0,0"/>
                        <TextBlock Text="Thư mục khách hàng" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                    </StackPanel>
                </Border>

                <!-- Metric 4: Customers (Emerald / Mint) -->
                <Border Grid.Column="3" Background="{StaticResource Tinix.Color.Card.Customer.Bg}" BorderBrush="{StaticResource Tinix.Color.Card.Customer.Border}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Lg}" Padding="16,14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="KHÁCH HÀNG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Card.Customer.Title}"/>
                        <TextBlock Text="{Binding TotalCustomers, StringFormat='{}{0} khách'}" FontFamily="{StaticResource Tinix.Font.Display}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Card.Customer.Value}" Margin="0,4,0,0"/>
                        <TextBlock Text="Danh tính chuẩn hóa" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                    </StackPanel>
                </Border>

                <!-- Metric 5: Unresolved / Locked (Amber / Gold) -->
                <Border Grid.Column="4" Background="{StaticResource Tinix.Color.Card.Review.Bg}" BorderBrush="{StaticResource Tinix.Color.Card.Review.Border}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Lg}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="CẦN XỬ LÝ / ĐÃ TÍNH BILL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Card.Review.Title}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding UnresolvedOrdersCount}" FontFamily="{StaticResource Tinix.Font.Display}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Danger}"/>
                            <TextBlock Text=" / " FontFamily="{StaticResource Tinix.Font.Display}" FontSize="20" Foreground="{StaticResource Tinix.Color.Text.Muted}"/>
                            <TextBlock Text="{Binding LockedOrdersCount}" FontFamily="{StaticResource Tinix.Font.Display}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Info}"/>
                        </StackPanel>
                        <TextBlock Text="Chờ xử lý / Đã tính bill" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- DATA TABLES (TABBED) -->
        <Border Grid.Row="3" Margin="24,16,24,10" Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Lg}" Padding="18">
            <TabControl BorderThickness="0" Background="Transparent">
                <!-- TAB 1: CUSTOMERS BREAKDOWN -->
                <TabItem Header="👥 Theo Khách Hàng">
                    <DataGrid ItemsSource="{Binding CustomerSummaries}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="38" BorderThickness="0" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Khách Hàng (Chuẩn Hóa)" Binding="{Binding DisplayName}" Width="250" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Số Đơn Vật Lý" Binding="{Binding TotalOrders}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,16,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tổng Số Lượng In" Binding="{Binding TotalBillQuantity, StringFormat='{}{0:N0}'}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="0,0,16,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tổng Doanh Thu (VND)" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} đ'}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tinix.Color.Success}"/>
                                        <Setter Property="Padding" Value="0,0,16,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Trạng Thái" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="{StaticResource Tinix.Radius.Full}" Padding="8,2" Background="{StaticResource Tinix.Color.Success.Bg}" BorderBrush="{StaticResource Tinix.Color.Success.Border}" BorderThickness="1" Visibility="{Binding HasUnresolvedIssues, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                                <TextBlock Text="Sẵn sàng" Foreground="{StaticResource Tinix.Color.Success}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border CornerRadius="{StaticResource Tinix.Radius.Full}" Padding="8,2" Background="{StaticResource Tinix.Color.Warning.Bg}" BorderBrush="{StaticResource Tinix.Color.Warning.Border}" BorderThickness="1" Visibility="{Binding HasUnresolvedIssues, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Có đơn cần xử lý (!)" Foreground="{StaticResource Tinix.Color.Warning}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- TAB 2: SPECIFICATIONS BREAKDOWN -->
                <TabItem Header="🏷️ Theo Quy Cách In">
                    <DataGrid ItemsSource="{Binding SpecificationSummaries}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="38" BorderThickness="0" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Quy Cách In" Binding="{Binding SpecificationName}" Width="300" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Số Lượng Tính Tiền (Tấm)" Binding="{Binding TotalBillQuantity, StringFormat='{}{0:N0}'}" Width="220">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="0,0,16,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Doanh Thu (VND)" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} đ'}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tinix.Color.Success}"/>
                                        <Setter Property="Padding" Value="0,0,16,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- TAB 3: DAILY BREAKDOWN -->
                <TabItem Header="📅 Theo Ngày Hoạt Động">
                    <DataGrid ItemsSource="{Binding DailySummaries}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="38" BorderThickness="0" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ngày Làm Việc" Binding="{Binding Date}" Width="180" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Số Đơn Hàng" Binding="{Binding TotalOrders}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,16,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Số Lượng Ảnh In" Binding="{Binding TotalBillQuantity, StringFormat='{}{0:N0}'}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="0,0,16,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Doanh Thu (VND)" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} đ'}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tinix.Color.Success}"/>
                                        <Setter Property="Padding" Value="0,0,16,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Trạng Thái" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="{StaticResource Tinix.Radius.Full}" Padding="8,2" Background="{StaticResource Tinix.Color.Success.Bg}" BorderBrush="{StaticResource Tinix.Color.Success.Border}" BorderThickness="1" Visibility="{Binding HasUnresolvedIssues, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                                <TextBlock Text="Đầy đủ / Chuẩn" Foreground="{StaticResource Tinix.Color.Success}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border CornerRadius="{StaticResource Tinix.Radius.Full}" Padding="8,2" Background="{StaticResource Tinix.Color.Warning.Bg}" BorderBrush="{StaticResource Tinix.Color.Warning.Border}" BorderThickness="1" Visibility="{Binding HasUnresolvedIssues, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Có đơn cần xử lý (!)" Foreground="{StaticResource Tinix.Color.Warning}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="4" Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="12" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding ScanProgressText}" Foreground="{StaticResource Tinix.Color.Primary}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
