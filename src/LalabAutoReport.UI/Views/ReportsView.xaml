<UserControl x:Class="LalabAutoReport.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LalabAutoReport.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1050">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Controls & Scope -->
            <RowDefinition Height="Auto"/> <!-- Missing Days Banner -->
            <RowDefinition Height="Auto"/> <!-- KPI Metric Cards -->
            <RowDefinition Height="*"/>    <!-- Data Tables -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP BAR: Mode Selection & Date Pickers -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Report Mode Radio Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Báo cáo: " FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton Content="Theo tháng" IsChecked="True" Checked="ModeMonthly_Checked" Margin="0,0,14,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <RadioButton Content="Theo ngày" Checked="ModeDaily_Checked" Margin="0,0,14,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <RadioButton Content="Khoảng ngày" Checked="ModeDateRange_Checked" Margin="0,0,14,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Date Pickers depending on mode -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <!-- Monthly Mode Controls -->
                    <StackPanel x:Name="MonthlyControls" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding PreviousMonthCommand}" Content="◀" Width="28" Height="30" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand"/>
                        <TextBlock Text="{Binding SelectedMonth, StringFormat='Tháng {0}'}" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBlock Text="/" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedYear}" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="4,0,8,0"/>
                        <Button Command="{Binding NextMonthCommand}" Content="▶" Width="28" Height="30" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand"/>
                        <Button Command="{Binding CurrentMonthCommand}" Content="Tháng này" Height="30" Padding="10,0" Margin="8,0,0,0" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Daily Mode Controls -->
                    <StackPanel x:Name="DailyControls" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Chọn ngày:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding SelectedDailyDate}" Height="30" Width="140" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- DateRange Mode Controls -->
                    <StackPanel x:Name="DateRangeControls" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Từ:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Height="30" Width="130" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Đến:" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,6,0"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Height="30" Width="130" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Refresh / Load Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding LoadReportCommand}" Content="🔄 Làm mới" Height="32" Padding="14,0" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MISSING DAYS ALERT BANNER -->
        <Border Grid.Row="1" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="0,0,0,1" Padding="20,10" Visibility="{Binding HasMissingScanDays, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚠️ " FontSize="16"/>
                    <TextBlock Text="Phát hiện ngày chưa được quét trong tháng: " FontWeight="SemiBold" Foreground="#92400E" VerticalAlignment="Center"/>
                    <ItemsControl ItemsSource="{Binding MissingScanDays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FDE68A" CornerRadius="4" Padding="6,2" Margin="4,0">
                                    <TextBlock Text="{Binding}" FontWeight="Bold" Foreground="#78350F" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding ScanMissingDaysCommand}" Content="⚡ Quét các ngày còn thiếu" Padding="14,6" Background="#D97706" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" IsEnabled="{Binding IsScanning, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
            </Grid>
        </Border>

        <!-- KPI METRICS ROW -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Metric 1: Revenue -->
                <Border Grid.Column="0" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="DOANH THU" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                        <TextBlock Text="{Binding FormattedTotalRevenue}" FontSize="20" FontWeight="ExtraBold" Foreground="#15803D" Margin="0,4,0,0"/>
                        <TextBlock Text="VND integer" FontSize="10" Foreground="#86EFAC"/>
                    </StackPanel>
                </Border>

                <!-- Metric 2: Bill Quantity -->
                <Border Grid.Column="1" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="SỐ LƯỢNG ẢNH IN" FontSize="11" FontWeight="Bold" Foreground="#075985"/>
                        <TextBlock Text="{Binding TotalBillQuantity, StringFormat='{}{0:N0} tấm'}" FontSize="20" FontWeight="ExtraBold" Foreground="#0284C7" Margin="0,4,0,0"/>
                        <TextBlock Text="Tổng sản lượng" FontSize="10" Foreground="#7DD3FC"/>
                    </StackPanel>
                </Border>

                <!-- Metric 3: Orders -->
                <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="ĐƠN HÀNG VẬT LÝ" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock Text="{Binding TotalOrders, StringFormat='{}{0} đơn'}" FontSize="20" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,4,0,0"/>
                        <TextBlock Text="Thư mục khách hàng" FontSize="10" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Metric 4: Customers -->
                <Border Grid.Column="3" Background="#FAF5FF" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="KHÁCH HÀNG" FontSize="11" FontWeight="Bold" Foreground="#6B21A8"/>
                        <TextBlock Text="{Binding TotalCustomers, StringFormat='{}{0} khách'}" FontSize="20" FontWeight="ExtraBold" Foreground="#9333EA" Margin="0,4,0,0"/>
                        <TextBlock Text="Danh tính chuẩn hóa" FontSize="10" Foreground="#D8B4FE"/>
                    </StackPanel>
                </Border>

                <!-- Metric 5: Unresolved / Locked -->
                <Border Grid.Column="4" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="CẦN XỬ LÝ / ĐÃ KHÓA" FontSize="11" FontWeight="Bold" Foreground="#92400E"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding UnresolvedOrdersCount}" FontSize="20" FontWeight="ExtraBold" Foreground="#DC2626"/>
                            <TextBlock Text=" / " FontSize="18" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding LockedOrdersCount}" FontSize="20" FontWeight="ExtraBold" Foreground="#1565C0"/>
                        </StackPanel>
                        <TextBlock Text="Cảnh báo / Lịch sử" FontSize="10" Foreground="#FBBF24"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- DATA TABLES (TABBED) -->
        <Border Grid.Row="3" Margin="24,16,24,10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
            <TabControl BorderThickness="0" Background="Transparent">
                <!-- TAB 1: CUSTOMERS BREAKDOWN -->
                <TabItem Header="👥 Theo Khách Hàng" FontWeight="SemiBold" FontSize="13">
                    <DataGrid ItemsSource="{Binding CustomerSummaries}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="36" BorderThickness="0" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Khách Hàng (Chuẩn Hóa)" Binding="{Binding DisplayName}" Width="250" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Số Đơn Vật Lý" Binding="{Binding TotalOrders}" Width="140"/>
                            <DataGridTextColumn Header="Tổng Số Lượng In" Binding="{Binding TotalBillQuantity, StringFormat='{}{0:N0}'}" Width="160"/>
                            <DataGridTextColumn Header="Tổng Doanh Thu (VND)" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} đ'}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#16A34A"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Trạng Thái" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="4" Padding="6,2" Background="#BBF7D0" Visibility="{Binding HasUnresolvedIssues, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                                <TextBlock Text="Sẵn sàng" Foreground="#166534" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border CornerRadius="4" Padding="6,2" Background="#FED7AA" Visibility="{Binding HasUnresolvedIssues, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Có đơn cần xử lý (!)" Foreground="#9A3412" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- TAB 2: SPECIFICATIONS BREAKDOWN -->
                <TabItem Header="🏷️ Theo Quy Cách In" FontWeight="SemiBold" FontSize="13">
                    <DataGrid ItemsSource="{Binding SpecificationSummaries}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="36" BorderThickness="0" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Quy Cách In" Binding="{Binding SpecificationName}" Width="300" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Số Lượng Tính Tiền (Tấm)" Binding="{Binding TotalBillQuantity, StringFormat='{}{0:N0}'}" Width="220"/>
                            <DataGridTextColumn Header="Doanh Thu (VND)" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} đ'}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#16A34A"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- TAB 3: DAILY BREAKDOWN -->
                <TabItem Header="📅 Theo Ngày Hoạt Động" FontWeight="SemiBold" FontSize="13">
                    <DataGrid ItemsSource="{Binding DailySummaries}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="36" BorderThickness="0" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ngày Làm Việc" Binding="{Binding Date}" Width="180" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Số Đơn Hàng" Binding="{Binding TotalOrders}" Width="150"/>
                            <DataGridTextColumn Header="Số Lượng Ảnh In" Binding="{Binding TotalBillQuantity, StringFormat='{}{0:N0}'}" Width="180"/>
                            <DataGridTextColumn Header="Doanh Thu (VND)" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} đ'}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#16A34A"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Trạng Thái" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="4" Padding="6,2" Background="#BBF7D0" Visibility="{Binding HasUnresolvedIssues, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                                <TextBlock Text="Đầy đủ / Chuẩn" Foreground="#166534" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border CornerRadius="4" Padding="6,2" Background="#FED7AA" Visibility="{Binding HasUnresolvedIssues, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Có đơn cần xử lý (!)" Foreground="#9A3412" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#475569" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="14" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding ScanProgressText}" Foreground="#0284C7" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
