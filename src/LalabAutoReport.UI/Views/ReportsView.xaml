<UserControl x:Class="LalabAutoReport.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LalabAutoReport.UI.ViewModels"
             xmlns:converters="clr-namespace:LalabAutoReport.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1050">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource Tinix.Color.Bg.Body}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Controls & Scope -->
            <RowDefinition Height="Auto"/> <!-- Missing Days Banner -->
            <RowDefinition Height="Auto"/> <!-- KPI Metric Cards -->
            <RowDefinition Height="*"/>    <!-- Data Tables -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP BAR: Mode Selection & Date Pickers -->
        <Border Grid.Row="0" Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Report Mode Radio Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Phạm vi báo cáo:" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="13"/>
                    <RadioButton Content="Theo tháng" IsChecked="True" Checked="ModeMonthly_Checked" Margin="0,0,16,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                    <RadioButton Content="Theo ngày" Checked="ModeDaily_Checked" Margin="0,0,16,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                    <RadioButton Content="Khoảng ngày" Checked="ModeDateRange_Checked" Margin="0,0,16,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                </StackPanel>

                <!-- Date Pickers depending on mode -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <!-- Monthly Mode Controls -->
                    <StackPanel x:Name="MonthlyControls" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding PreviousMonthCommand}" Content="◀" Width="30" Height="34" Style="{StaticResource Tinix.Button.Secondary}" Padding="0"/>
                        <TextBlock Text="{Binding SelectedMonth, StringFormat='Tháng {0}'}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center" Margin="10,0,4,0" FontSize="13"/>
                        <TextBlock Text="/" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Muted}" VerticalAlignment="Center" FontSize="13"/>
                        <TextBlock Text="{Binding SelectedYear}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center" Margin="4,0,10,0" FontSize="13"/>
                        <Button Command="{Binding NextMonthCommand}" Content="▶" Width="30" Height="34" Style="{StaticResource Tinix.Button.Secondary}" Padding="0"/>
                        <Button Command="{Binding CurrentMonthCommand}" Content="Tháng này" Height="34" Style="{StaticResource Tinix.Button.Secondary}" Padding="12,0" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Daily Mode Controls -->
                    <StackPanel x:Name="DailyControls" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Chọn ngày:" Foreground="{StaticResource Tinix.Color.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                        <DatePicker SelectedDate="{Binding SelectedDailyDate}" Height="34" Width="140" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- DateRange Mode Controls -->
                    <StackPanel x:Name="DateRangeControls" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Từ:" Foreground="{StaticResource Tinix.Color.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Height="34" Width="130" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Đến:" Foreground="{StaticResource Tinix.Color.Text.Secondary}" VerticalAlignment="Center" Margin="10,0,6,0" FontSize="13"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Height="34" Width="130" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Refresh / Load Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding LoadReportCommand}" Content="🔄 Làm mới" Height="36" Padding="18,0" Style="{StaticResource Tinix.Button.Primary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MISSING DAYS ALERT BANNER -->
        <Border Grid.Row="1" Background="{StaticResource Tinix.Color.Warning.Bg}" BorderBrush="{StaticResource Tinix.Color.Warning.Border}" BorderThickness="0,0,0,1" Padding="20,12" Visibility="{Binding HasMissingScanDays, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚠️ " FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Phát hiện ngày chưa được quét trong tháng: " FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Warning}" VerticalAlignment="Center" FontSize="13"/>
                    <ItemsControl ItemsSource="{Binding MissingScanDays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FDE68A" CornerRadius="{StaticResource Tinix.Radius.Sm}" Padding="8,2" Margin="4,0" BorderBrush="{StaticResource Tinix.Color.Warning.Border}" BorderThickness="1">
                                    <TextBlock Text="{Binding}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Warning}" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding ScanMissingDaysCommand}" Content="⚡ Quét các ngày còn thiếu" Style="{StaticResource Tinix.Button.Primary}" Padding="16,6" FontSize="12" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"/>
            </Grid>
        </Border>

        <!-- KPI METRICS ROW -->
        <Border Grid.Row="2" Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Metric 1: Revenue -->
                <Border Grid.Column="0" Background="{StaticResource Tinix.Color.Bg.Subtle}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Lg}" Padding="16,14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="DOANH THU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Primary}"/>
                        <TextBlock Text="{Binding FormattedTotalRevenue}" FontFamily="{StaticResource Tinix.Font.Display}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Success}" Margin="0,4,0,0"/>
                        <TextBlock Text="Đơn vị: VND (nguyên)" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Muted}"/>
                    </StackPanel>
                </Border>

                <!-- Metric 2: Bill Quantity -->
                <Border Grid.Column="1" Background="{StaticResource Tinix.Color.Bg.Subtle}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Lg}" Padding="16,14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="SẢN LƯỢNG IN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                        <TextBlock Text="{Binding TotalBillQuantity, StringFormat='{}{0:N0} tấm'}" FontFamily="{StaticResource Tinix.Font.Display}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}" Margin="0,4,0,0"/>
                        <TextBlock Text="Tổng ảnh in tính tiền" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Muted}"/>
                    </StackPanel>
                </Border>

                <!-- Metric 3: Orders -->
                <Border Grid.Column="2" Background="{StaticResource Tinix.Color.Bg.Subtle}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Lg}" Padding="16,14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="ĐƠN HÀNG VẬT LÝ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                        <TextBlock Text="{Binding TotalOrders, StringFormat='{}{0} đơn'}" FontFamily="{StaticResource Tinix.Font.Display}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}" Margin="0,4,0,0"/>
                        <TextBlock Text="Thư mục khách hàng" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Muted}"/>
                    </StackPanel>
                </Border>

                <!-- Metric 4: Customers -->
                <Border Grid.Column="3" Background="{StaticResource Tinix.Color.Bg.Subtle}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Lg}" Padding="16,14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="KHÁCH HÀNG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                        <TextBlock Text="{Binding TotalCustomers, StringFormat='{}{0} khách'}" FontFamily="{StaticResource Tinix.Font.Display}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}" Margin="0,4,0,0"/>
                        <TextBlock Text="Danh tính chuẩn hóa" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Muted}"/>
                    </StackPanel>
                </Border>

                <!-- Metric 5: Unresolved / Locked -->
                <Border Grid.Column="4" Background="{StaticResource Tinix.Color.Bg.Subtle}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Lg}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="CẦN XỬ LÝ / ĐÃ TÍNH BILL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding UnresolvedOrdersCount}" FontFamily="{StaticResource Tinix.Font.Display}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Danger}"/>
                            <TextBlock Text=" / " FontFamily="{StaticResource Tinix.Font.Display}" FontSize="20" Foreground="{StaticResource Tinix.Color.Text.Muted}"/>
                            <TextBlock Text="{Binding LockedOrdersCount}" FontFamily="{StaticResource Tinix.Font.Display}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Info}"/>
                        </StackPanel>
                        <TextBlock Text="Chờ xử lý / Đã tính bill" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Muted}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- DATA TABLES (TABBED) -->
        <Border Grid.Row="3" Margin="24,16,24,10" Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Lg}" Padding="18">
            <TabControl BorderThickness="0" Background="Transparent">
                <!-- TAB 1: CUSTOMERS BREAKDOWN -->
                <TabItem Header="👥 Theo Khách Hàng">
                    <DataGrid ItemsSource="{Binding CustomerSummaries}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="38" BorderThickness="0" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Khách Hàng (Chuẩn Hóa)" Binding="{Binding DisplayName}" Width="250" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Số Đơn Vật Lý" Binding="{Binding TotalOrders}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,16,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tổng Số Lượng In" Binding="{Binding TotalBillQuantity, StringFormat='{}{0:N0}'}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="0,0,16,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tổng Doanh Thu (VND)" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} đ'}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tinix.Color.Success}"/>
                                        <Setter Property="Padding" Value="0,0,16,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Trạng Thái" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="{StaticResource Tinix.Radius.Full}" Padding="8,2" Background="{StaticResource Tinix.Color.Success.Bg}" BorderBrush="{StaticResource Tinix.Color.Success.Border}" BorderThickness="1" Visibility="{Binding HasUnresolvedIssues, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                                <TextBlock Text="Sẵn sàng" Foreground="{StaticResource Tinix.Color.Success}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border CornerRadius="{StaticResource Tinix.Radius.Full}" Padding="8,2" Background="{StaticResource Tinix.Color.Warning.Bg}" BorderBrush="{StaticResource Tinix.Color.Warning.Border}" BorderThickness="1" Visibility="{Binding HasUnresolvedIssues, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Có đơn cần xử lý (!)" Foreground="{StaticResource Tinix.Color.Warning}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- TAB 2: SPECIFICATIONS BREAKDOWN -->
                <TabItem Header="🏷️ Theo Quy Cách In">
                    <DataGrid ItemsSource="{Binding SpecificationSummaries}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="38" BorderThickness="0" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Quy Cách In" Binding="{Binding SpecificationName}" Width="300" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Số Lượng Tính Tiền (Tấm)" Binding="{Binding TotalBillQuantity, StringFormat='{}{0:N0}'}" Width="220">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="0,0,16,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Doanh Thu (VND)" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} đ'}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tinix.Color.Success}"/>
                                        <Setter Property="Padding" Value="0,0,16,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- TAB 3: DAILY BREAKDOWN -->
                <TabItem Header="📅 Theo Ngày Hoạt Động">
                    <DataGrid ItemsSource="{Binding DailySummaries}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="38" BorderThickness="0" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ngày Làm Việc" Binding="{Binding Date}" Width="180" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Số Đơn Hàng" Binding="{Binding TotalOrders}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,16,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Số Lượng Ảnh In" Binding="{Binding TotalBillQuantity, StringFormat='{}{0:N0}'}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="0,0,16,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Doanh Thu (VND)" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} đ'}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tinix.Color.Success}"/>
                                        <Setter Property="Padding" Value="0,0,16,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Trạng Thái" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="{StaticResource Tinix.Radius.Full}" Padding="8,2" Background="{StaticResource Tinix.Color.Success.Bg}" BorderBrush="{StaticResource Tinix.Color.Success.Border}" BorderThickness="1" Visibility="{Binding HasUnresolvedIssues, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                                <TextBlock Text="Đầy đủ / Chuẩn" Foreground="{StaticResource Tinix.Color.Success}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border CornerRadius="{StaticResource Tinix.Radius.Full}" Padding="8,2" Background="{StaticResource Tinix.Color.Warning.Bg}" BorderBrush="{StaticResource Tinix.Color.Warning.Border}" BorderThickness="1" Visibility="{Binding HasUnresolvedIssues, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Có đơn cần xử lý (!)" Foreground="{StaticResource Tinix.Color.Warning}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- TAB 4: ALL INVOICES / BILL HISTORY -->
                <TabItem Header="🧾 Danh Sách Hóa Đơn">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Filter Toolbar -->
                            <RowDefinition Height="*"/>    <!-- DataGrid or Empty View -->
                        </Grid.RowDefinitions>

                        <!-- Filter Toolbar -->
                        <Border Grid.Row="0" Background="{StaticResource Tinix.Color.Bg.Subtle}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="14,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Quick Scope Toggle -->
                                    <ColumnDefinition Width="Auto"/> <!-- Type Filter -->
                                    <ColumnDefinition Width="*"/>    <!-- Search Box -->
                                    <ColumnDefinition Width="Auto"/> <!-- Count & Total Amount Badge -->
                                </Grid.ColumnDefinitions>

                                <!-- Quick Scope Toggle -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Phạm vi:" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                    <Border Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="6,3" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton GroupName="BillHistoryScope" Content="Theo kỳ báo cáo" IsChecked="{Binding BillScopeReportPeriod, Mode=TwoWay}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,10,0" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                                            <RadioButton GroupName="BillHistoryScope" Content="Toàn bộ lịch sử" IsChecked="{Binding BillScopeAllTime, Mode=TwoWay}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Type Filter -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Loại:" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                    <ComboBox SelectedValue="{Binding BillTypeFilter, Mode=TwoWay}" SelectedValuePath="Tag" Height="34" Width="170" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Tất cả loại bill" Tag="All" IsSelected="True"/>
                                        <ComboBoxItem Content="👤 Khách quen" Tag="Customer"/>
                                        <ComboBoxItem Content="⚡ Khách lẻ (Quick Bill)" Tag="Guest"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Search Box -->
                                <TextBox Grid.Column="2" Text="{Binding BillSearchText, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,16,0" VerticalContentAlignment="Center">
                                    <TextBox.Resources>
                                        <VisualBrush x:Key="CueSearchBills" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="🔍 Tìm mã bill, khách hàng, số điện thoại..." Foreground="{StaticResource Tinix.Color.Text.Muted}" Margin="8,0" FontSize="{StaticResource Tinix.FontSize.Caption}"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </TextBox.Resources>
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource Tinix.TextBox.Standard}">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background" Value="{StaticResource CueSearchBills}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- Count & Total Amount Badge -->
                                <Border Grid.Column="3" Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="12,5" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TotalReportBillsCount, StringFormat='{}{0} hóa đơn'}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="  •  " Foreground="{StaticResource Tinix.Color.Text.Muted}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FormattedReportBillsAmount}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Success}" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- DataGrid -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredReportBills}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="42" BorderThickness="0">
                            <DataGrid.Columns>
                                <!-- Mã Hóa Đơn -->
                                <DataGridTemplateColumn Header="Mã Hóa Đơn" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding BillNumber}" FontFamily="{StaticResource Tinix.Font.Mono}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Tinix.Color.Primary}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Phân Loại -->
                                <DataGridTemplateColumn Header="Loại Bill" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Guest Badge -->
                                                <Border Background="#FEF3C7" CornerRadius="{StaticResource Tinix.Radius.Sm}" Padding="6,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BillType}" Value="Guest">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="⚡ Khách Lẻ" FontSize="10" FontWeight="Bold" Foreground="#B45309"/>
                                                </Border>

                                                <!-- Customer Badge -->
                                                <Border Background="#E0E7FF" CornerRadius="{StaticResource Tinix.Radius.Sm}" Padding="6,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BillType}" Value="Customer">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="👤 Khách Quen" FontSize="10" FontWeight="Bold" Foreground="#4338CA"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Khách Hàng -->
                                <DataGridTemplateColumn Header="Khách Hàng" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CustomerNameSnapshot}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                                                <TextBlock Text="{Binding PhoneSnapshot}" FontSize="10" Foreground="{StaticResource Tinix.Color.Text.Muted}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Kỳ Hóa Đơn -->
                                <DataGridTemplateColumn Header="Kỳ Hóa Đơn" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PeriodStart, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                                                <TextBlock Text=" ➔ " FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Muted}"/>
                                                <TextBlock Text="{Binding PeriodEnd, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Số Đơn -->
                                <DataGridTextColumn Header="Số Đơn" Binding="{Binding OrderCount, StringFormat='{}{0} đơn'}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontSize" Value="11"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Tổng Tiền -->
                                <DataGridTextColumn Header="Tổng Tiền (VND)" Binding="{Binding GrandTotal, StringFormat='{}{0:N0} đ'}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="{StaticResource Tinix.Color.Success}"/>
                                            <Setter Property="Padding" Value="0,0,12,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Trạng Thái -->
                                <DataGridTemplateColumn Header="Trạng Thái" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="{StaticResource Tinix.Radius.Full}" Padding="8,2" Background="{StaticResource Tinix.Color.Success.Bg}" BorderBrush="{StaticResource Tinix.Color.Success.Border}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Success}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Thao Tác -->
                                <DataGridTemplateColumn Header="Thao Tác" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="👁️ Mở Bill" 
                                                        Command="{Binding DataContext.OpenBillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" 
                                                        Style="{StaticResource Tinix.Button.Secondary}" 
                                                        Padding="10,4" Margin="0,0,6,0" FontSize="11"/>
                                                <Button Content="🖼️ Ảnh" 
                                                        Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" 
                                                        Style="{StaticResource Tinix.Button.Ghost}" 
                                                        Padding="8,4" Margin="0,0,6,0" FontSize="11" ToolTip="Mở tệp ảnh JPEG đã xuất"/>
                                                <Button Content="📁 Thư Mục" 
                                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" 
                                                        Style="{StaticResource Tinix.Button.Ghost}" 
                                                        Padding="8,4" Margin="0,0,6,0" FontSize="11" ToolTip="Mở thư mục chứa file hóa đơn"/>
                                                <Button Content="🔄 Xuất Lại" 
                                                        Command="{Binding DataContext.ReExportJpegCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" 
                                                        Style="{StaticResource Tinix.Button.Ghost}" 
                                                        Padding="8,4" FontSize="11" ToolTip="Xuất lại file hóa đơn JPEG và Excel"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty State if no bills found -->
                        <Border Grid.Row="1" Background="White" Visibility="{Binding HasNoBillsFound, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40,30">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🧾" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Không tìm thấy hóa đơn nào trong phạm vi đã chọn" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Tinix.Color.Text.Secondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Các hóa đơn đã khóa hoặc đã xuất sẽ hiển thị tại đây." FontSize="12" Foreground="{StaticResource Tinix.Color.Text.Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="4" Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="12" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding ScanProgressText}" Foreground="{StaticResource Tinix.Color.Primary}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
