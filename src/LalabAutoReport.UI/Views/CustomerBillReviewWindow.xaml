<Window x:Class="LalabAutoReport.UI.Views.CustomerBillReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:domain="clr-namespace:LalabAutoReport.Core.Domain;assembly=LalabAutoReport.Core"
        xmlns:vm="clr-namespace:LalabAutoReport.UI.ViewModels"
        xmlns:behaviors="clr-namespace:LalabAutoReport.UI.Behaviors"
        xmlns:converters="clr-namespace:LalabAutoReport.UI.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="820" Width="1240"
        MinHeight="650" MinWidth="980"
        Icon="../Resources/app.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Tinix.Font.UI}"
        Background="{StaticResource Tinix.Color.Bg.Body}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Alert / Status Banners -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0" Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Lg}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="20,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left info -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FEF3C7" CornerRadius="{StaticResource Tinix.Radius.Sm}" Padding="8,3" Margin="0,0,8,0" Visibility="{Binding IsGuestBill, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="⚡ KHÁCH LẺ" FontWeight="Bold" Foreground="#B45309" FontSize="11"/>
                        </Border>
                        <Border Background="{StaticResource Tinix.Color.Primary.Subtle}" CornerRadius="{StaticResource Tinix.Radius.Sm}" Padding="8,3" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Bill.Status}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Primary}" FontSize="12"/>
                        </Border>
                        <TextBlock Text="{Binding Bill.BillNumber}" FontFamily="{StaticResource Tinix.Font.Mono}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center"/>
                        <TextBlock Text=" • " Foreground="{StaticResource Tinix.Color.Text.Muted}" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Bill.CustomerNameSnapshot}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center"/>
                        <Button Command="{Binding EditGuestNameCommand}" Content="✏️" Width="26" Height="26" Style="{StaticResource Tinix.Button.Ghost}" Padding="0" Margin="6,0,0,0" ToolTip="Đổi tên khách lẻ" Visibility="{Binding IsGuestBill, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Kỳ hóa đơn: " Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="13"/>
                        <TextBlock Text="{Binding Bill.PeriodStart}" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontSize="13"/>
                        <TextBlock Text=" → " Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="13"/>
                        <TextBlock Text="{Binding Bill.PeriodEnd}" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontSize="13"/>
                        <TextBlock Text="  |  Tạo lúc: " Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="13" Margin="12,0,0,0"/>
                        <TextBlock Text="{Binding Bill.CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Foreground="{StaticResource Tinix.Color.Text.Muted}" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsGuestBill, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="📁 Thư mục nguồn: " Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="12"/>
                        <TextBlock Text="{Binding SourceFoldersSummary}" FontFamily="{StaticResource Tinix.Font.Mono}" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ConvertGuestToCustomerCommand}" Content="👤 Chuyển thành Khách Hàng" Height="36" Style="{StaticResource Tinix.Button.Secondary}" Padding="14,0" Margin="0,0,8,0" Visibility="{Binding IsGuestBill, Converter={StaticResource BoolToVis}}"/>
                    <Button Command="{Binding RescanDraftCommand}" Content="🔄 Quét Lại Dữ Liệu" Height="36" Style="{StaticResource Tinix.Button.Secondary}" Padding="14,0" Margin="0,0,8,0"/>
                    <Button Command="{Binding ReopenBillCommand}" Content="🔓 Mở Khóa Sửa" Height="36" Style="{StaticResource Tinix.Button.Secondary}" Padding="14,0" Margin="0,0,8,0" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"/>
                    <Button Command="{Binding CloseWindowCommand}" Content="Đóng" Height="36" Style="{StaticResource Tinix.Button.Secondary}" Padding="16,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ALERTS & NOTICES -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <!-- Locked State Banner -->
            <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="14,10" Margin="0,0,0,6" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔒 " FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Hóa đơn này đang ở trạng thái ĐÃ KHÓA / ĐÃ XUẤT. Các ô số liệu bị khóa để đảm bảo an toàn. Bấm nút [🔓 Mở Khóa Sửa] nếu cần điều chỉnh lại." Foreground="#92400E" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding ReopenBillCommand}" Content="🔓 Mở Khóa Sửa" Height="28" Style="{StaticResource Tinix.Button.Secondary}" Padding="12,0"/>
                </Grid>
            </Border>

            <!-- Suggested Customer Banner -->
            <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="14,10" Margin="0,0,0,6" Visibility="{Binding HasSuggestedCustomer, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💡 " FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Tìm thấy khách quen trùng tên: " Foreground="{StaticResource Tinix.Color.Primary}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SuggestedCustomer.CanonicalName}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Primary}" FontSize="12" VerticalAlignment="Center" Margin="4,0"/>
                        <TextBlock Text="— Bạn có muốn gán hóa đơn này vào khách quen không?" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding ConvertGuestToSuggestedCustomerCommand}" Content="👤 Gán Vào Khách Này" Height="28" Style="{StaticResource Tinix.Button.Primary}" Padding="12,0"/>
                </Grid>
            </Border>

            <!-- Warning Banner -->
            <Border Background="{StaticResource Tinix.Color.Warning.Bg}" BorderBrush="{StaticResource Tinix.Color.Warning.Border}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="14,10" Margin="0,0,0,6" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="⚠️ CẢNH BÁO TÍNH TIỀN:" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Warning}" FontSize="12" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='• {0}'}" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontSize="12" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Blocking Issues Banner -->
            <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="14,10" Margin="0,0,0,6" Visibility="{Binding HasBlockingIssues, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="⛔ CÁC MỤC LỖI / CHƯA XỬ LÝ (Không thể xuất bill khi chưa sửa hoặc bỏ chọn):" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Danger}" FontSize="12" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding BlockingIssues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='• {0}'}" Foreground="{StaticResource Tinix.Color.Danger}" FontWeight="SemiBold" FontSize="12" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Export Success Banner -->
            <Border Background="{StaticResource Tinix.Color.Success.Bg}" BorderBrush="{StaticResource Tinix.Color.Success.Border}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="14,10" Visibility="{Binding IsExportSuccess, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✅ " FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Đã xuất hóa đơn JPEG thành công: " FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Success}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ExportedFilePath}" FontFamily="{StaticResource Tinix.Font.Mono}" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding OpenExportedFileCommand}" Content="📄 Mở File JPEG" Height="30" Style="{StaticResource Tinix.Button.Secondary}" Padding="12,0" Margin="0,0,6,0"/>
                        <Button Command="{Binding OpenExportedFolderCommand}" Content="📁 Mở Thư Mục" Height="30" Style="{StaticResource Tinix.Button.Secondary}" Padding="12,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: ORDERS & BILL LINES REVIEW TABLE -->
            <Border Grid.Column="0" Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Lg}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="16" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CHI TIẾT ĐƠN HÀNG VÀ CÁC DÒNG SẢN PHẨM" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="12" Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Orders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CustomerBillOrderDisplayModel}">
                                    <Border Background="{StaticResource Tinix.Color.Bg.Subtle}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="12" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/> <!-- Order Header -->
                                                <RowDefinition Height="Auto"/> <!-- Column Labels -->
                                                <RowDefinition Height="Auto"/> <!-- Product Lines -->
                                                <RowDefinition Height="Auto"/> <!-- Order Subtotal -->
                                            </Grid.RowDefinitions>

                                            <!-- Order Header -->
                                            <Border Grid.Row="0" Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Sm}" Padding="10,6" Margin="0,0,0,8" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsIncluded}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📁 " FontSize="13" VerticalAlignment="Center"/>
                                                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayOrderCode}" FontWeight="SemiBold" FontSize="12" Foreground="#334155" FontFamily="Consolas, Segoe UI Mono, monospace"/>
                                                        </Border>
                                                        <TextBox Text="{Binding OrderName, UpdateSourceTrigger=PropertyChanged}" 
                                                                 FontWeight="Bold" FontSize="13" 
                                                                 Foreground="{StaticResource Tinix.Color.Text.Primary}"
                                                                 Height="28" MinWidth="130" MaxWidth="320"
                                                                 Padding="6,0" VerticalContentAlignment="Center"
                                                                 Style="{StaticResource Tinix.TextBox.Standard}"
                                                                 ToolTip="Tên đơn hàng (nhấp để chỉnh sửa trước khi xuất bill)"/>
                                                        <TextBlock Text="  •  Ngày: " Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="13" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding OrderDate}" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontSize="13" VerticalAlignment="Center"/>
                                                        <Border Background="{StaticResource Tinix.Color.Warning.Bg}" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" Visibility="{Binding IsFromPreviousPeriod, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                                                            <TextBlock Text="Đơn từ kỳ trước" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Warning}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Tạm tính đơn: " Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="13"/>
                                                        <TextBlock Text="{Binding Subtotal, StringFormat='{}{0:#,##0} đ'}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Primary}" FontSize="14"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Table Column Header -->
                                            <Grid Grid.Row="1" Margin="6,0,6,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>  <!-- Checkbox -->
                                                    <ColumnDefinition Width="3*"/>  <!-- Sản phẩm -->
                                                    <ColumnDefinition Width="65"/>  <!-- SL quét -->
                                                    <ColumnDefinition Width="75"/>  <!-- SL tính -->
                                                    <ColumnDefinition Width="95"/>  <!-- Đơn giá -->
                                                    <ColumnDefinition Width="105"/> <!-- Thành tiền -->
                                                    <ColumnDefinition Width="2*"/>  <!-- Ghi chú -->
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="Sản phẩm / Quy cách" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                                                <TextBlock Grid.Column="2" Text="SL Quét" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="SL Tính" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Tinix.Color.Primary}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="Đơn Giá" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Tinix.Color.Primary}" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="5" Text="Thành Tiền" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Primary}" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="6" Text="Ghi Chú" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="8,0,0,0"/>
                                            </Grid>

                                            <!-- Lines List -->
                                            <ItemsControl Grid.Row="2" ItemsSource="{Binding Lines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:CustomerBillLineDisplayModel}">
                                                        <Border Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Sm}" Padding="6,6" Margin="0,2" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="30"/>  <!-- Checkbox -->
                                                                    <ColumnDefinition Width="3*"/>  <!-- Sản phẩm -->
                                                                    <ColumnDefinition Width="65"/>  <!-- SL quét -->
                                                                    <ColumnDefinition Width="75"/>  <!-- SL tính -->
                                                                    <ColumnDefinition Width="95"/>  <!-- Đơn giá -->
                                                                    <ColumnDefinition Width="105"/> <!-- Thành tiền -->
                                                                    <ColumnDefinition Width="2*"/>  <!-- Ghi chú -->
                                                                </Grid.ColumnDefinitions>

                                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded}" IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                                <!-- Product name & details -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontSize="13"/>
                                                                        <TextBlock Text="{Binding FolderBadgeText}" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="11" Margin="6,2,0,0" VerticalAlignment="Center"/>
                                                                        <Border Background="#FEE2E2" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" Visibility="{Binding HasIssue, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                                                                            <TextBlock Text="Lỗi" Foreground="{StaticResource Tinix.Color.Danger}" FontWeight="Bold" FontSize="10"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding AlbumDetails}" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="11" Margin="0,2,0,0" Visibility="{Binding IsAlbum, Converter={StaticResource BoolToVis}}"/>
                                                                    <TextBlock Text="{Binding IssueMessage}" Foreground="{StaticResource Tinix.Color.Danger}" FontSize="11" Margin="0,2,0,0" Visibility="{Binding HasIssue, Converter={StaticResource BoolToVis}}"/>
                                                                </StackPanel>

                                                                <!-- Scanned Quantity -->
                                                                <TextBlock Grid.Column="2" Text="{Binding ScannedQuantity}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="13"/>

                                                                <!-- Billed Quantity (Editable) -->
                                                                <TextBox Grid.Column="3" Text="{Binding BilledQuantity, Converter={StaticResource NumberThousandsConverter}, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=Window}}" behaviors:NumericInputBehavior.IsThousands="True" Width="65" Height="28" TextAlignment="Center" VerticalContentAlignment="Center" Margin="2,0" Style="{StaticResource Tinix.TextBox.Standard}"/>

                                                                <!-- Billed Unit Price (Editable) -->
                                                                <TextBox Grid.Column="4" Text="{Binding BilledUnitPrice, Converter={StaticResource NumberThousandsConverter}, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=Window}}" behaviors:NumericInputBehavior.IsThousands="True" Width="85" Height="28" TextAlignment="Right" VerticalContentAlignment="Center" Margin="2,0" Style="{StaticResource Tinix.TextBox.Standard}"/>

                                                                <!-- Line Total -->
                                                                <TextBlock Grid.Column="5" Text="{Binding LineTotal, StringFormat='{}{0:#,##0} đ'}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13"/>

                                                                <!-- Line Note (Editable) -->
                                                                <TextBox Grid.Column="6" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=Window}}" Height="28" VerticalContentAlignment="Center" Margin="8,0,0,0" ToolTip="Nhập ghi chú cho dòng này">
                                                                    <TextBox.Resources>
                                                                        <VisualBrush x:Key="CueNote" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                                            <VisualBrush.Visual>
                                                                                <TextBlock Text="Ghi chú..." Foreground="{StaticResource Tinix.Color.Text.Muted}" Margin="6,0" FontSize="11"/>
                                                                            </VisualBrush.Visual>
                                                                        </VisualBrush>
                                                                    </TextBox.Resources>
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox" BasedOn="{StaticResource Tinix.TextBox.Standard}">
                                                                            <Style.Triggers>
                                                                                <Trigger Property="Text" Value="">
                                                                                    <Setter Property="Background" Value="{StaticResource CueNote}"/>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT: ADJUSTMENTS, NOTE, & TOTALS SUMMARY -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- ADJUSTMENTS CARD -->
                        <Border Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Lg}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="CÁC KHOẢN ĐIỀU CHỈNH" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="12" Margin="0,0,0,12"/>

                                <!-- Adjustments list -->
                                <ItemsControl ItemsSource="{Binding Adjustments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CustomerBillAdjustmentDisplayModel}">
                                            <Border Background="{StaticResource Tinix.Color.Bg.Subtle}" CornerRadius="{StaticResource Tinix.Radius.Sm}" Padding="8,6" Margin="0,0,0,6" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Background="{StaticResource Tinix.Color.Primary.Subtle}" CornerRadius="3" Padding="4,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DirectionSign}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Primary}" FontSize="12"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center" FontSize="13"/>

                                                    <TextBox Grid.Column="2" Text="{Binding Amount, Converter={StaticResource NumberThousandsConverter}, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=Window}}" behaviors:NumericInputBehavior.IsThousands="True" Height="28" TextAlignment="Right" VerticalContentAlignment="Center" Style="{StaticResource Tinix.TextBox.Standard}"/>

                                                    <Button Grid.Column="3" Command="{Binding DataContext.RemoveAdjustmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Tinix.Button.Icon.Danger}" ToolTip="Xóa khoản này" Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVis}}" Margin="4,0,0,0">
                                                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Add Custom Adjustment Input -->
                                <Border Margin="0,6,0,0" Padding="0,10,0,0" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,1,0,0" IsEnabled="{Binding IsEditable}">
                                    <StackPanel>
                                        <TextBlock Text="Thêm khoản điều chỉnh khác:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding NewCustomLabel, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,4,0">
                                                <TextBox.Resources>
                                                    <VisualBrush x:Key="CueLabel" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Tên khoản (vd: Đóng gói)" Foreground="{StaticResource Tinix.Color.Text.Muted}" Margin="6,0" FontSize="11"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </TextBox.Resources>
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource Tinix.TextBox.Standard}">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Background" Value="{StaticResource CueLabel}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <ComboBox Grid.Column="1" SelectedValue="{Binding NewCustomDirection}" Height="30" VerticalContentAlignment="Center">
                                                <ComboBoxItem Content="Cộng (+)" Tag="{x:Static domain:AdjustmentDirection.Add}" IsSelected="True"/>
                                                <ComboBoxItem Content="Trừ (-)" Tag="{x:Static domain:AdjustmentDirection.Deduct}"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding NewCustomAmount, Converter={StaticResource NumberThousandsConverter}, ConverterParameter=ZeroAsEmpty, UpdateSourceTrigger=PropertyChanged}" behaviors:NumericInputBehavior.IsThousands="True" behaviors:NumericInputBehavior.AllowEmpty="True" Height="30" Margin="0,0,6,0">
                                                <TextBox.Resources>
                                                    <VisualBrush x:Key="CueAmount" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Số tiền (VND)" Foreground="{StaticResource Tinix.Color.Text.Muted}" Margin="6,0" FontSize="11"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </TextBox.Resources>
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource Tinix.TextBox.Standard}">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Background" Value="{StaticResource CueAmount}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <Button Grid.Column="1" Command="{Binding AddCustomAdjustmentCommand}" Content="+ Thêm" Style="{StaticResource Tinix.Button.Secondary}" Height="30" Padding="12,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- NOTE CARD -->
                        <Border Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Lg}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="GHI CHÚ IN TRÊN HÓA ĐƠN" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="12" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" Style="{StaticResource Tinix.TextBox.Standard}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- SUMMARY CARD & EXPORT BUTTON (Fixed at Bottom Right) -->
                <Border Grid.Row="1" Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Lg}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="TỔNG HỢP THANH TOÁN" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="12" Margin="0,0,0,8"/>

                        <Grid Margin="0,2">
                            <TextBlock Text="Tổng cộng:" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="13"/>
                            <TextBlock Text="{Binding ProductSubtotal, StringFormat='{}{0:#,##0} đ'}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontSize="13"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="Các khoản điều chỉnh:" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="13"/>
                            <TextBlock Text="{Binding AdjustmentsTotal, StringFormat='{}{0:#,##0} đ'}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="13"/>
                        </Grid>

                        <Separator Margin="0,8" Background="{StaticResource Tinix.Color.Border.Subtle}"/>

                        <!-- Prominent Grand Total -->
                        <Border Background="{StaticResource Tinix.Color.Primary.Subtle}" BorderBrush="{StaticResource Tinix.Color.Primary}" BorderThickness="1.5" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="14,10" Margin="0,4,0,12">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TỔNG TIỀN" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Primary}" FontSize="12"/>
                                    <TextBlock Text="THANH TOÁN" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Primary}" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:#,##0} đ'}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Primary}" FontSize="24"/>
                            </Grid>
                        </Border>

                        <!-- Action Buttons: View Exported Bill, Folder, & Export -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding OpenExportedFileCommand}"
                                    IsEnabled="{Binding CanViewExportedBill}"
                                    Height="40"
                                    Style="{StaticResource Tinix.Button.Info}"
                                    ToolTip="{Binding ViewBillToolTip}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Width="16" Height="14" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Margin="0,0,8,0" VerticalAlignment="Center"
                                          Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
                                    <TextBlock Text="XEM LẠI BILL" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1"
                                    Command="{Binding OpenExportedFolderCommand}"
                                    IsEnabled="{Binding CanViewExportedBill}"
                                    Height="40" Width="40"
                                    Padding="0"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource Tinix.Button.Info}"
                                    ToolTip="{Binding FolderToolTip}">
                                <Path Width="18" Height="15" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/>
                            </Button>
                        </Grid>

                        <!-- Big Export Button -->
                        <Button Command="{Binding ExportBillCommand}" Height="44" Style="{StaticResource Tinix.Button.Primary}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡ " FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ExportButtonText}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- FOOTER STATUS -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource Tinix.Color.Primary}" FontWeight="SemiBold" FontSize="12" Margin="4,8,4,0"/>
    </Grid>
</Window>
