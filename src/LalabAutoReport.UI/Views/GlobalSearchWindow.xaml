<Window x:Class="LalabAutoReport.UI.Views.GlobalSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LalabAutoReport.UI.ViewModels"
        xmlns:interfaces="clr-namespace:LalabAutoReport.Core.Interfaces;assembly=LalabAutoReport.Core"
        mc:Ignorable="d"
        Title="Tìm Kiếm Toàn Cục"
        Width="740" Height="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource Tinix.Font.UI}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- Outer shadow wrapper -->
    <Border Margin="14" CornerRadius="12" Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.22" Color="#0F172A"/>
        </Border.Effect>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Search input -->
                <RowDefinition Height="Auto"/> <!-- Separator -->
                <RowDefinition Height="*"/>    <!-- Results list -->
                <RowDefinition Height="Auto"/> <!-- Footer status & hotkey hints -->
            </Grid.RowDefinitions>

            <!-- 1. Search Input Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🔍" FontSize="18" VerticalAlignment="Center" Margin="4,0,12,0"/>

                <TextBox x:Name="SearchInputBox" Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16" FontWeight="SemiBold"
                         Height="42"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource Tinix.TextBox.Standard}"
                         BorderThickness="0"
                         Background="Transparent"
                         ToolTip="Nhập mã đơn, số bill, tên khách hàng, số điện thoại, thư mục..."/>

                <Border Grid.Column="2" Background="{StaticResource Tinix.Color.Bg.Subtle}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="ESC để đóng" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Muted}"/>
                </Border>
            </Grid>

            <!-- 2. Separator -->
            <Separator Grid.Row="1" Margin="-18,0,-18,8" Background="{StaticResource Tinix.Color.Border.Subtle}"/>

            <!-- 3. Results List / Empty State -->
            <Grid Grid.Row="2">
                <!-- Empty Placeholder -->
                <Border Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding Results.Count, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.5"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="{StaticResource Tinix.Color.Text.Secondary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Gõ mã đơn (vd: 001), số bill (vd: BILL-2026), tên khách hoặc thư mục" FontSize="11.5" Foreground="{StaticResource Tinix.Color.Text.Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Results ListBox -->
                <ListBox x:Name="ResultsListBox"
                         ItemsSource="{Binding Results}"
                         SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseDoubleClick="ResultsListBox_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{StaticResource Tinix.Color.Bg.Subtle}" CornerRadius="8" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="12,10">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tinix.Color.Primary.Subtle}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tinix.Color.Primary}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tinix.Color.Primary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type interfaces:GlobalSearchResult}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Type Badge -->
                                <Border Grid.Column="0" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F0FDF4"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ResultType}" Value="Bill">
                                                    <Setter Property="Background" Value="#EEF2FF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ResultType}" Value="Order">
                                                    <Setter Property="Background" Value="#F0F9FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="10.5" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="MỤC"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ResultType}" Value="Bill">
                                                        <Setter Property="Text" Value="HÓA ĐƠN"/>
                                                        <Setter Property="Foreground" Value="#4F46E5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ResultType}" Value="Order">
                                                        <Setter Property="Text" Value="ĐƠN HÀNG"/>
                                                        <Setter Property="Foreground" Value="#0284C7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Middle Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Tinix.Font.Mono}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                                        <TextBlock Text=" • " Foreground="{StaticResource Tinix.Color.Text.Muted}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Date}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Tinix.Color.Text.Secondary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Right Info: Amount & Badges -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <!-- Bill Amount if present -->
                                    <TextBlock Text="{Binding Amount, Converter={StaticResource NumberThousandsConverter}, StringFormat='{}{0:#,##0} đ'}"
                                               FontWeight="Bold" FontSize="13" Foreground="{StaticResource Tinix.Color.Primary}" HorizontalAlignment="Right" Margin="0,0,0,2">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ResultType}" Value="Bill">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Status / Payment Badge -->
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                                        <Setter Property="Background" Value="#D1FAE5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="10" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Status}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Tinix.Color.Text.Primary}"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ResultType}" Value="Bill"/>
                                                                <Condition Binding="{Binding IsPaid}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Text" Value="✓ Đã thanh toán"/>
                                                            <Setter Property="Foreground" Value="#065F46"/>
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ResultType}" Value="Bill"/>
                                                                <Condition Binding="{Binding IsPaid}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Text" Value="⏳ Chưa thanh toán"/>
                                                            <Setter Property="Foreground" Value="#B45309"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 4. Footer & Shortcut Hint -->
            <Border Grid.Row="3" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{StaticResource Tinix.Color.Text.Secondary}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="[↑↓] Di chuyển  •  [Enter] Mở chi tiết  •  [ESC] Đóng" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Muted}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
