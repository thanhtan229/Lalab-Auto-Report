<UserControl x:Class="LalabAutoReport.UI.Views.PriceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:domain="clr-namespace:LalabAutoReport.Core.Domain;assembly=LalabAutoReport.Core"
             xmlns:behaviors="clr-namespace:LalabAutoReport.UI.Behaviors"
             xmlns:converters="clr-namespace:LalabAutoReport.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NumberThousandsConverter x:Key="NumberThousandsConverter"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource Tinix.Color.Bg.Body}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="ĐƠN GIÁ &amp; QUY CÁCH" FontSize="{StaticResource Tinix.FontSize.Caption}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Primary}" Margin="0,0,0,4"/>
            <TextBlock Text="Bảng Giá Quy Cách In Ảnh &amp; Album" FontFamily="{StaticResource Tinix.Font.Display}" FontSize="{StaticResource Tinix.FontSize.Display}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Specifications Table & Add Form -->
            <Border Grid.Column="0" Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Lg}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Margin="0,0,16,0" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Specs List -->
                    <ListBox Grid.Row="0" 
                             ItemsSource="{Binding Specifications}" 
                             SelectedItem="{Binding SelectedSpec}" 
                             BorderThickness="0" 
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" 
                                                    Background="{StaticResource Tinix.Color.Bg.Subtle}" 
                                                    CornerRadius="{StaticResource Tinix.Radius.Md}" 
                                                    BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" 
                                                    BorderThickness="1"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter Margin="14,10"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Tinix.Color.Primary}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Tinix.Color.Primary.Subtle}"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Tinix.Color.Primary}"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type domain:PrintSpecification}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CanonicalName}" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{StaticResource Tinix.Color.Text.Primary}" 
                                                   FontSize="{StaticResource Tinix.FontSize.Body}" 
                                                   VerticalAlignment="Center"/>
                                        <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" Background="#EEF2F6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#455A64" FontWeight="Medium"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Row="0" Grid.Column="1" 
                                               FontWeight="Bold" 
                                               Foreground="{StaticResource Tinix.Color.Primary}" 
                                               FontSize="{StaticResource Tinix.FontSize.Body}" 
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding UnitPrice, StringFormat='{}{0:N0} đ/ảnh'}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Category}" Value="Album">
                                                        <Setter Property="Text" Value="{Binding BasePrice, StringFormat='{}{0:N0} đ/gói'}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                                               Text="{Binding Aliases.Count, StringFormat='{}Số alias: {0}'}" 
                                               FontSize="{StaticResource Tinix.FontSize.Caption}" 
                                               Foreground="{StaticResource Tinix.Color.Text.Secondary}" 
                                               Margin="0,4,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Add Specification Form -->
                    <Border Grid.Row="1" Margin="0,16,0,0" Padding="0,14,0,0" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="Thêm sản phẩm / quy cách mới:" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" Margin="0,0,0,8" FontSize="{StaticResource Tinix.FontSize.Small}"/>
                            
                            <!-- Category Selection -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" 
                                          ItemsSource="{Binding AvailableCategories}" 
                                          SelectedItem="{Binding NewCategory}" 
                                          Height="34" 
                                          Margin="0,0,6,0"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Padding="0"/>
                                <TextBox Grid.Column="1" Text="{Binding NewSpecName, UpdateSourceTrigger=PropertyChanged}" Height="34">
                                    <TextBox.Resources>
                                        <VisualBrush x:Key="CueSpecName" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="Tên sản phẩm (vd: Album 25x25 hoặc 13x18 in)" Foreground="{StaticResource Tinix.Color.Text.Muted}" Margin="8,0" FontSize="{StaticResource Tinix.FontSize.Caption}"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </TextBox.Resources>
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource Tinix.TextBox.Standard}">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background" Value="{StaticResource CueSpecName}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>

                            <!-- PhotoPrint Price Field -->
                            <StackPanel Visibility="{Binding IsCreatingPhotoPrint, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <TextBlock Text="Đơn giá mỗi ảnh in (VND):" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding NewSpecPrice, Converter={StaticResource NumberThousandsConverter}, UpdateSourceTrigger=PropertyChanged}" behaviors:NumericInputBehavior.IsThousands="True" Height="34" Style="{StaticResource Tinix.TextBox.Standard}"/>
                            </StackPanel>

                            <!-- Album Pricing Fields -->
                            <StackPanel Visibility="{Binding IsCreatingAlbum, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Giá gói album (VND):" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="11" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding NewBasePrice, Converter={StaticResource NumberThousandsConverter}, UpdateSourceTrigger=PropertyChanged}" behaviors:NumericInputBehavior.IsThousands="True" Height="34" Style="{StaticResource Tinix.TextBox.Standard}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Số tờ chuẩn:" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="11" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding NewIncludedSheets, Converter={StaticResource NumberThousandsConverter}, UpdateSourceTrigger=PropertyChanged}" behaviors:NumericInputBehavior.IsThousands="True" Height="34" Style="{StaticResource Tinix.TextBox.Standard}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Giá mỗi tờ phát sinh thêm (VND/tờ):" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding NewExtraSheetPrice, Converter={StaticResource NumberThousandsConverter}, UpdateSourceTrigger=PropertyChanged}" behaviors:NumericInputBehavior.IsThousands="True" Height="34" Style="{StaticResource Tinix.TextBox.Standard}"/>
                            </StackPanel>

                            <Button Command="{Binding CreateSpecificationCommand}" Content="Thêm Sản Phẩm" Height="36" Style="{StaticResource Tinix.Button.Info}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: Aliases & Edit -->
            <Border Grid.Column="1" Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Lg}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Edit Selected Spec Section -->
                    <Border Grid.Row="0" Background="{StaticResource Tinix.Color.Bg.Subtle}" CornerRadius="{StaticResource Tinix.Radius.Md}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SẢN PHẨM ĐANG CHỌN" FontSize="{StaticResource Tinix.FontSize.Caption}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,0,0,2"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedSpec.CanonicalName}" FontSize="{StaticResource Tinix.FontSize.Section}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource Tinix.Button.Icon}" Margin="10,0,0,0" ToolTip="Đổi tên quy cách/sản phẩm" Click="RenameSpec_Click" VerticalAlignment="Center">
                                            <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border CornerRadius="{StaticResource Tinix.Radius.Full}" Padding="10,3" Background="#EEF2F6" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding SelectedSpec.Category}" Foreground="#455A64" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <Button Style="{StaticResource Tinix.Button.Secondary}" Height="30" Padding="10,0" ToolTip="Xóa quy cách sản phẩm này" Click="DeleteSpec_Click" VerticalAlignment="Center" Foreground="{StaticResource Tinix.Color.Danger}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource Tinix.Color.Danger}" Margin="0,0,6,0" VerticalAlignment="Center" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                            <TextBlock Text="Xóa Quy Cách" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Edit PhotoPrint Price -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSpec.Category}" Value="PhotoPrint">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Đơn giá VND/ảnh:" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="11" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding EditUnitPrice, Converter={StaticResource NumberThousandsConverter}, UpdateSourceTrigger=PropertyChanged}" behaviors:NumericInputBehavior.IsThousands="True" Height="34" Style="{StaticResource Tinix.TextBox.Standard}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{Binding SaveSelectedSpecCommand}" Content="Lưu Đơn Giá" VerticalAlignment="Bottom" Height="34" Padding="16,0" Style="{StaticResource Tinix.Button.Info}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Edit Album Pricing -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSpec.Category}" Value="Album">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Giá gói album (VND):" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="11" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding EditBasePrice, Converter={StaticResource NumberThousandsConverter}, UpdateSourceTrigger=PropertyChanged}" behaviors:NumericInputBehavior.IsThousands="True" Height="34" Style="{StaticResource Tinix.TextBox.Standard}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                        <TextBlock Text="Số tờ chuẩn:" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="11" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding EditIncludedSheets, Converter={StaticResource NumberThousandsConverter}, UpdateSourceTrigger=PropertyChanged}" behaviors:NumericInputBehavior.IsThousands="True" Height="34" Style="{StaticResource Tinix.TextBox.Standard}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                        <TextBlock Text="Giá tờ phát sinh (VND):" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="11" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding EditExtraSheetPrice, Converter={StaticResource NumberThousandsConverter}, UpdateSourceTrigger=PropertyChanged}" behaviors:NumericInputBehavior.IsThousands="True" Height="34" Style="{StaticResource Tinix.TextBox.Standard}"/>
                                    </StackPanel>
                                </Grid>
                                <Button Command="{Binding SaveSelectedSpecCommand}" Content="Lưu Cấu Hình Album" Height="34" Margin="0,4,0,0" Style="{StaticResource Tinix.Button.Info}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- TabControl for Specific Aliases vs Shared Family Aliases -->
                    <TabControl Grid.Row="1" Grid.RowSpan="3" Background="Transparent" BorderThickness="0" Margin="0,0,0,12">
                        <!-- Tab 1: Product-Specific Aliases -->
                        <TabItem Header="Alias Riêng Của Sản Phẩm">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Alias chính xác map riêng vào sản phẩm này:" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,0,0,8" FontSize="{StaticResource Tinix.FontSize.Small}"/>

                                <ListBox Grid.Row="1" ItemsSource="{Binding SelectedSpec.Aliases}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" Background="{StaticResource Tinix.Color.Bg.Subtle}" Margin="0,0,0,12" Padding="6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type domain:PrintSpecificationAlias}">
                                            <Border Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="10,6" Margin="0,2" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding AliasText}" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center" FontFamily="{StaticResource Tinix.Font.Mono}" FontSize="{StaticResource Tinix.FontSize.Small}"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource Tinix.Button.Icon}" Margin="0,0,6,0" ToolTip="Sửa alias quy cách" Click="EditAlias_Click">
                                                            <Path Width="13" Height="13" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                                                        </Button>
                                                        <Button Style="{StaticResource Tinix.Button.Icon.Danger}" ToolTip="Xóa alias quy cách" Click="RemoveAlias_Click">
                                                            <Path Width="13" Height="13" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="Thêm alias cho riêng quy cách này (ví dụ: '13x18' map vào '13x18 in'):" FontSize="{StaticResource Tinix.FontSize.Caption}" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewSpecAlias, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tinix.TextBox.Standard}" Height="34"/>
                                        <Button Grid.Column="1" Command="{Binding AddAliasCommand}" Content="Thêm Alias" Margin="8,0,0,0" Style="{StaticResource Tinix.Button.Info}" Padding="16,0" Height="34"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <!-- Tab 2: Shared Family Aliases -->
                        <TabItem Header="Alias Dòng (Dùng Chung Mọi Size)">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Chọn dòng sản phẩm: " VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontSize="{StaticResource Tinix.FontSize.Small}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily}" DisplayMemberPath="Name" Height="32" VerticalContentAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="💡 Alias ở đây được dùng chung cho TẤT CẢ các kích thước thuộc dòng (vd: 'ab', 'alb', 'album' cho Album; 'in', 'anh' cho Ảnh in)." FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Muted}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <ListBox Grid.Row="1" ItemsSource="{Binding SelectedFamily.Aliases}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" Background="{StaticResource Tinix.Color.Bg.Subtle}" Margin="0,0,0,12" Padding="6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type domain:ProductFamilyAlias}">
                                            <Border Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="10,6" Margin="0,2" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding AliasText}" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center" FontFamily="{StaticResource Tinix.Font.Mono}" FontSize="{StaticResource Tinix.FontSize.Small}"/>
                                                    <Button Grid.Column="1" Style="{StaticResource Tinix.Button.Icon.Danger}" ToolTip="Xóa alias dùng chung" Click="RemoveFamilyAlias_Click">
                                                        <Path Width="13" Height="13" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="Thêm alias dùng chung mới (ví dụ: 'ab', 'alb', 'cuon'):" FontSize="{StaticResource Tinix.FontSize.Caption}" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewFamilyAlias, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tinix.TextBox.Standard}" Height="34"/>
                                        <Button Grid.Column="1" Command="{Binding AddFamilyAliasCommand}" Content="Thêm Family Alias" Margin="8,0,0,0" Style="{StaticResource Tinix.Button.Info}" Padding="16,0" Height="34"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <!-- Status -->
                    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="{StaticResource Tinix.Color.Success}" FontWeight="SemiBold" FontSize="{StaticResource Tinix.FontSize.Caption}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
