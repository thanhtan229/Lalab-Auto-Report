<Window x:Class="LalabAutoReport.UI.Views.ManageFamilyAliasesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:domain="clr-namespace:LalabAutoReport.Core.Domain;assembly=LalabAutoReport.Core"
        xmlns:viewmodels="clr-namespace:LalabAutoReport.UI.ViewModels"
        mc:Ignorable="d"
        Title="Quản Lý Dòng Sản Phẩm &amp; Alias (Dùng Chung)"
        Width="820"
        Height="600"
        MinWidth="700"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="{StaticResource Tinix.Font.UI}"
        Background="{StaticResource Tinix.Color.Bg.Body}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock Text="🧩" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Cấu Hình Dòng Sản Phẩm &amp; Alias (Dùng Chung)" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource Tinix.Color.Text.Primary}" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Explanatory Banner -->
                <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="12,10" Margin="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="💡" FontSize="16" VerticalAlignment="Top" Margin="0,1,10,0"/>
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12" Foreground="#0369A1" LineHeight="18">
                            <Run FontWeight="SemiBold" Text="Nguyên lý hoạt động: "/>
                            <Run Text="Các từ khóa này áp dụng chung cho tất cả các kích thước thuộc dòng đó (ví dụ: 'ab', 'alb' -> Album; 'in', 'cp' -> Ảnh in; 'ep', 'plastic' -> Ép plastic). Hệ thống sẽ kết hợp từ khóa dòng + kích thước trong tên thư mục để tự động phân giải quy cách."/>
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>

            <Button Grid.Column="1" 
                    Content="➕ Thêm Dòng Mới..." 
                    Height="36" 
                    Padding="14,0" 
                    VerticalAlignment="Top" 
                    Margin="16,0,0,0" 
                    Style="{StaticResource Tinix.Button.Primary}" 
                    Click="AddFamily_Click"/>
        </Grid>

        <!-- Side-by-side Family Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
            <ItemsControl ItemsSource="{Binding FamilyCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:FamilyCardViewModel}">
                        <Border Background="{StaticResource Tinix.Color.Bg.Surface}" 
                                BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" 
                                BorderThickness="1" 
                                CornerRadius="{StaticResource Tinix.Radius.Lg}" 
                                Padding="16" 
                                Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Card Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayIcon}" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource Tinix.Button.Icon}" Margin="6,0,0,0" ToolTip="Đổi tên dòng sản phẩm" Click="RenameFamily_Click" Visibility="{Binding CanRename, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                                            <Path Width="11" Height="11" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{StaticResource Tinix.Color.Primary.Subtle}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Aliases.Count, StringFormat='{}{0} từ khóa'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Primary}"/>
                                        </Border>
                                        <Button Style="{StaticResource Tinix.Button.Icon.Danger}" ToolTip="Xóa dòng sản phẩm này" Click="DeleteFamily_Click" Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                                            <Path Width="12" Height="12" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Description -->
                                <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>

                                <!-- List of Aliases -->
                                <Border Grid.Row="2" Background="{StaticResource Tinix.Color.Bg.Subtle}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="6" Margin="0,0,0,12" MinHeight="170">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Aliases}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type domain:ProductFamilyAlias}">
                                                    <Border Background="{StaticResource Tinix.Color.Bg.Surface}" 
                                                            BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" 
                                                            BorderThickness="1" 
                                                            CornerRadius="{StaticResource Tinix.Radius.Sm}" 
                                                            Padding="10,6" 
                                                            Margin="0,0,0,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding AliasText}" 
                                                                       FontWeight="SemiBold" 
                                                                       FontFamily="{StaticResource Tinix.Font.Mono}" 
                                                                       FontSize="13" 
                                                                       Foreground="{StaticResource Tinix.Color.Text.Primary}" 
                                                                       VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Style="{StaticResource Tinix.Button.Icon}" 
                                                                        Margin="0,0,4,0" 
                                                                        ToolTip="Sửa từ khóa này" 
                                                                        Click="EditAlias_Click">
                                                                    <Path Width="11" Height="11" Stretch="Uniform" 
                                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                                                          Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                                                                </Button>
                                                                <Button Style="{StaticResource Tinix.Button.Icon.Danger}" 
                                                                        ToolTip="Xóa từ khóa này" 
                                                                        Click="RemoveAlias_Click">
                                                                    <Path Width="12" Height="12" Stretch="Uniform" 
                                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                                                          Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <!-- Add Alias Form -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewAliasInput, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="34" 
                                             FontSize="12"
                                             KeyDown="NewAliasTextBox_KeyDown">
                                        <TextBox.Resources>
                                            <VisualBrush x:Key="CueAddAlias" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Thêm từ khóa mới..." Foreground="{StaticResource Tinix.Color.Text.Muted}" Margin="8,0" FontSize="11"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </TextBox.Resources>
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource Tinix.TextBox.Standard}">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Background" Value="{StaticResource CueAddAlias}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Button Grid.Column="1" 
                                            Content="➕ Thêm" 
                                            Height="34" 
                                            Padding="14,0" 
                                            Margin="8,0,0,0" 
                                            Style="{StaticResource Tinix.Button.Info}" 
                                            Click="AddAlias_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status message -->
            <TextBlock Text="{Binding StatusMessage}" 
                       FontWeight="SemiBold" 
                       FontSize="{StaticResource Tinix.FontSize.Small}" 
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Tinix.Color.Success}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSuccessStatus}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Tinix.Color.Danger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Close button -->
            <Button Grid.Column="1" 
                    Content="Đóng" 
                    Width="100" 
                    Height="36" 
                    Style="{StaticResource Tinix.Button.Secondary}" 
                    IsCancel="True" 
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
