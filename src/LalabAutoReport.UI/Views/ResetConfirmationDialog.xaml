<Window x:Class="LalabAutoReport.UI.Views.ResetConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xác Nhận Đặt Lại Dữ Liệu" Width="520" SizeToContent="Height"
        Icon="../Resources/app.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="{StaticResource Tinix.Font.UI}"
        Background="{StaticResource Tinix.Color.Bg.Body}">
    <Border Padding="24">
        <StackPanel>
            <!-- Danger Header -->
            <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="12" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="CẢNH BÁO: VÙNG NGUY HIỂM" FontWeight="Bold" FontSize="13" Foreground="#B91C1C"/>
                        <TextBlock Text="Thao tác này sẽ xóa vĩnh viễn dữ liệu đã chọn khỏi cơ sở dữ liệu." FontSize="12" Foreground="#991B1B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Scope Selection -->
            <TextBlock Text="Chọn phạm vi dữ liệu cần đặt lại:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Tinix.Color.Text.Primary}" Margin="0,0,0,10"/>

            <Border Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="14" Margin="0,0,0,10">
                <RadioButton x:Name="rbOperationalOnly" GroupName="ResetScopeGroup" IsChecked="True" Cursor="Hand">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="1. Chỉ xóa dữ liệu vận hành (Khuyên dùng)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                        <TextBlock Text="Xóa đơn hàng, lịch sử quét, hóa đơn, trạng thái đã in. Giữ lại 100% Khách hàng &amp; Bảng giá sản phẩm đã cấu hình." FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>
            </Border>

            <Border Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="14" Margin="0,0,0,16">
                <RadioButton x:Name="rbFactoryReset" GroupName="ResetScopeGroup" Cursor="Hand">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="2. Khôi phục cài đặt gốc toàn diện (Factory Reset)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                        <TextBlock Text="Xóa sạch 100% toàn bộ cơ sở dữ liệu (kể cả Khách hàng &amp; Bảng giá), đưa ứng dụng về trạng thái mới cài đặt ban đầu." FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>
            </Border>

            <!-- Safety Guarantee Notice -->
            <Border Background="{StaticResource Tinix.Color.Bg.Subtle}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="10" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🛡️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Tự động sao lưu: Hệ thống luôn lưu một bản backup an toàn trước khi xóa. Bạn có thể khôi phục lại bất cứ lúc nào." FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}" TextWrapping="Wrap" Width="420"/>
                </StackPanel>
            </Border>

            <!-- Confirmation Keyword Input -->
            <TextBlock Text="Để xác nhận, vui lòng gõ chữ &quot;reset&quot; vào ô bên dưới:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Tinix.Color.Text.Primary}" Margin="0,0,0,6"/>
            <TextBox x:Name="txtConfirmation" Style="{StaticResource Tinix.TextBox.Standard}" Height="36" FontSize="13" TextChanged="TxtConfirmation_TextChanged" Margin="0,0,0,20"/>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="Hủy Bỏ" Width="90" Height="36" Margin="0,0,10,0" Style="{StaticResource Tinix.Button.Secondary}" Click="Cancel_Click" IsCancel="True"/>
                <Button x:Name="btnConfirm" Grid.Column="2" Content="🗑️ Xác Nhận Xóa" Width="150" Height="36" Style="{StaticResource Tinix.Button.Danger}" IsEnabled="False" Click="Ok_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
