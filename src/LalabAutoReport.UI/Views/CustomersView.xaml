<UserControl x:Class="LalabAutoReport.UI.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:domain="clr-namespace:LalabAutoReport.Core.Domain;assembly=LalabAutoReport.Core"
             xmlns:converters="clr-namespace:LalabAutoReport.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1050">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:EnumToBooleanConverter x:Key="EnumToBoolConverter"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource Tinix.Color.Bg.Body}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="DANH MỤC KHÁCH HÀNG" FontSize="{StaticResource Tinix.FontSize.Caption}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Primary}" Margin="0,0,0,4"/>
                <TextBlock Text="Quản Lý Khách Hàng, Alias &amp; Lập Hóa Đơn" FontFamily="{StaticResource Tinix.Font.Display}" FontSize="{StaticResource Tinix.FontSize.Display}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding ComputeBillCommand}" IsEnabled="{Binding HasUnbilledOrders}" Height="38" Style="{StaticResource Tinix.Button.Primary}" Padding="18,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚡ " FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="TÍNH BILL" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Customer List & Search -->
            <Border Grid.Column="0" Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Lg}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Margin="0,0,16,0" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search -->
                    <TextBox Grid.Row="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,0,12">
                        <TextBox.Resources>
                            <VisualBrush x:Key="CueSearch" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                <VisualBrush.Visual>
                                    <TextBlock Text="🔍 Tìm kiếm khách hàng..." Foreground="{StaticResource Tinix.Color.Text.Muted}" Margin="8,0" FontSize="{StaticResource Tinix.FontSize.Caption}"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </TextBox.Resources>
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource Tinix.TextBox.Standard}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="{StaticResource CueSearch}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- List -->
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding FilteredCustomers}" 
                             SelectedItem="{Binding SelectedCustomer}" 
                             BorderThickness="0" 
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" 
                                                    Background="{StaticResource Tinix.Color.Bg.Subtle}" 
                                                    CornerRadius="{StaticResource Tinix.Radius.Md}" 
                                                    BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" 
                                                    BorderThickness="1"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter Margin="14,10"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Tinix.Color.Primary}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Tinix.Color.Primary.Subtle}"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Tinix.Color.Primary}"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type domain:Customer}">
                                <StackPanel>
                                    <TextBlock Text="{Binding CanonicalName}" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontSize="{StaticResource Tinix.FontSize.Body}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Aliases.Count, StringFormat='{}Số alias: {0}'}" FontSize="{StaticResource Tinix.FontSize.Caption}" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                                        <TextBlock Text="{Binding Phone, StringFormat='{} • SĐT: {0}'}" FontSize="{StaticResource Tinix.FontSize.Caption}" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                                        <TextBlock Text="{Binding PriceTier, StringFormat='{} • Cấp: {0}'}" FontSize="{StaticResource Tinix.FontSize.Caption}" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Add Customer -->
                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,12,0,0" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="Thêm khách hàng mới:" FontSize="{StaticResource Tinix.FontSize.Small}" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tinix.TextBox.Standard}" Height="34"/>
                                <Button Grid.Column="1" Command="{Binding CreateCustomerCommand}" Content="Thêm" Margin="6,0,0,0" Style="{StaticResource Tinix.Button.Info}" Padding="14,0" Height="34"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: Customer Detail, Unbilled Summary & Tabs -->
            <Border Grid.Column="1" Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Lg}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Customer Info Form -->
                        <RowDefinition Height="Auto"/> <!-- Unbilled Summary Card -->
                        <RowDefinition Height="*"/>    <!-- Tabbed Content: Bills / Aliases -->
                        <RowDefinition Height="Auto"/> <!-- Status message -->
                    </Grid.RowDefinitions>

                    <!-- Customer Header & Edit Info Form -->
                    <Border Grid.Row="0" Background="{StaticResource Tinix.Color.Bg.Subtle}" CornerRadius="{StaticResource Tinix.Radius.Md}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="14,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Header & Save Button -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="THÔNG TIN KHÁCH HÀNG CHUẨN" FontSize="{StaticResource Tinix.FontSize.Caption}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding SelectedCustomer.CanonicalName, TargetNullValue='(Chưa chọn khách hàng)'}" FontSize="{StaticResource Tinix.FontSize.Section}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding SaveCustomerInfoCommand}" Content="💾 Lưu Thông Tin" Height="32" Padding="14,0" Style="{StaticResource Tinix.Button.Info}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource Tinix.Button.Secondary}" Height="32" Padding="12,0" ToolTip="Xóa khách hàng này" Click="DeleteCustomer_Click" VerticalAlignment="Center" Foreground="{StaticResource Tinix.Color.Danger}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource Tinix.Color.Danger}" Margin="0,0,6,0" VerticalAlignment="Center" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                            <TextBlock Text="Xóa Khách Hàng" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Editable Fields -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Tên khách hàng chuẩn -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Tên khách hàng chuẩn:" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding EditCustomerName, UpdateSourceTrigger=PropertyChanged}" Height="32" Style="{StaticResource Tinix.TextBox.Standard}"/>
                                </StackPanel>

                                <!-- Số điện thoại -->
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Text="Số điện thoại:" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding EditCustomerPhone, UpdateSourceTrigger=PropertyChanged}" Height="32" Style="{StaticResource Tinix.TextBox.Standard}"/>
                                </StackPanel>

                                <!-- Địa chỉ giao hàng (In tem vận chuyển) -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,8,0">
                                    <TextBlock Text="Địa chỉ giao hàng (in tem dán):" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding EditCustomerAddress, UpdateSourceTrigger=PropertyChanged}" Height="32" Style="{StaticResource Tinix.TextBox.Standard}"
                                             ToolTip="Địa chỉ nhận hàng mặc định dùng khi in tem dán / phiếu giao hàng"/>
                                </StackPanel>

                                <!-- Ghi chú -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                    <TextBlock Text="Ghi chú:" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding EditCustomerNote, UpdateSourceTrigger=PropertyChanged}" Height="32" Style="{StaticResource Tinix.TextBox.Standard}"/>
                                </StackPanel>

                                <!-- Cấp độ bảng giá -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,8,0">
                                    <TextBlock Text="🏷️ Cấp độ bảng giá áp dụng:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" Margin="0,0,0,4"/>
                                    <UniformGrid Columns="3">
                                        <RadioButton Content="👤 Khách Lẻ"
                                                     GroupName="CustomerPriceTierGroup"
                                                     IsChecked="{Binding EditPriceTier, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Retail, Mode=TwoWay}"
                                                     Style="{StaticResource Tinix.PriceTierPill.Retail}"
                                                     Margin="0,0,6,0"
                                                     ToolTip="Khách Lẻ — Áp dụng mức giá chuẩn mặc định"/>
                                        <RadioButton Content="📷 Studio"
                                                     GroupName="CustomerPriceTierGroup"
                                                     IsChecked="{Binding EditPriceTier, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Studio, Mode=TwoWay}"
                                                     Style="{StaticResource Tinix.PriceTierPill.Studio}"
                                                     Margin="0,0,6,0"
                                                     ToolTip="Studio — Áp dụng mức giá ưu đãi cấp Studio"/>
                                        <RadioButton Content="⭐ Đại Lý"
                                                     GroupName="CustomerPriceTierGroup"
                                                     IsChecked="{Binding EditPriceTier, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Vip, Mode=TwoWay}"
                                                     Style="{StaticResource Tinix.PriceTierPill.Vip}"
                                                     ToolTip="Đại Lý — Bảng giá đại lý chiết khấu tốt nhất"/>
                                    </UniformGrid>
                                </StackPanel>

                                <!-- Gợi ý áp dụng giá -->
                                <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="10,8" Margin="0,14,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="💡 Khi tính bill, hệ thống tự động áp dụng giá theo cấp độ này. Nếu chưa đặt giá riêng, hệ thống tự dùng giá chuẩn khách lẻ." 
                                               FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}" TextWrapping="Wrap" LineHeight="16"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- BILLING & TRANSACTION SUMMARY CARD -->
                    <Border Grid.Row="1" Background="{StaticResource Tinix.Color.Bg.Subtle}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="16,14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Warning banner if unbilled from previous period -->
                            <Border Grid.Row="0" Background="{StaticResource Tinix.Color.Warning.Bg}" BorderBrush="{StaticResource Tinix.Color.Warning.Border}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Sm}" Padding="10,6" Margin="0,0,0,10"
                                    Visibility="{Binding UnbilledSummary.HasOrdersFromPreviousPeriod, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="⚠️ Phát hiện đơn hàng chưa tính bill từ các ngày trước kỳ gần nhất (sẽ được tự động gom vào bill mới)." Foreground="{StaticResource Tinix.Color.Warning}" FontWeight="SemiBold" FontSize="{StaticResource Tinix.FontSize.Caption}"/>
                            </Border>

                            <!-- Metrics -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Unbilled Orders -->
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock Text="ĐƠN CHƯA BILL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding UnbilledSummary.UnbilledOrderCount, FallbackValue='0'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Primary}"/>
                                </StackPanel>

                                <!-- Unbilled Jobs -->
                                <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                    <TextBlock Text="JOB IN CHƯA BILL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding UnbilledSummary.UnbilledJobCount, FallbackValue='0'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                                </StackPanel>

                                <!-- Estimated Total -->
                                <StackPanel Grid.Column="2" Margin="0,0,24,0">
                                    <TextBlock Text="ƯỚC TÍNH TẠM TÍNH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding UnbilledSummary.EstimatedTotal, Converter={StaticResource NumberThousandsConverter}, StringFormat='{}{0} đ', FallbackValue='0 đ'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Success}"/>
                                </StackPanel>

                                <!-- Total Debt -->
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="CÔNG NỢ CHƯA THU" FontSize="11" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding CustomerTotalDebtAmount, Converter={StaticResource NumberThousandsConverter}, StringFormat='{}{0} đ', FallbackValue='0 đ'}" FontSize="20" FontWeight="Bold" Foreground="#DC2626"/>
                                </StackPanel>
                            </Grid>

                            <!-- Transaction & Invoices Bar -->
                            <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,12,0,0" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🧾 Đã xuất:" FontSize="{StaticResource Tinix.FontSize.Small}" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CustomerTotalBillsCount, StringFormat='{}{0} hóa đơn'}" FontWeight="Bold" FontSize="{StaticResource Tinix.FontSize.Small}" Foreground="{StaticResource Tinix.Color.Text.Primary}" Margin="0,0,16,0" VerticalAlignment="Center"/>

                                        <TextBlock Text="💰 Doanh thu tích lũy:" FontSize="{StaticResource Tinix.FontSize.Small}" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CustomerTotalSpentAmount, Converter={StaticResource NumberThousandsConverter}, StringFormat='{}{0} đ'}" FontWeight="Bold" FontSize="{StaticResource Tinix.FontSize.Small}" Foreground="{StaticResource Tinix.Color.Primary}" Margin="0,0,16,0" VerticalAlignment="Center"/>

                                        <TextBlock Text="{Binding UnbilledSummary.LastBillNumber, StringFormat='{}• Gần nhất: {0}', TargetNullValue=''}" FontSize="{StaticResource Tinix.FontSize.Caption}" Foreground="{StaticResource Tinix.Color.Text.Muted}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Command="{Binding ViewCustomerInvoicesCommand}" Style="{StaticResource Tinix.Button.Secondary}" Height="32" Padding="14,0" Cursor="Hand" ToolTip="Chuyển sang tab Hóa Đơn và lọc riêng cho khách này">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🧾 Xem toàn bộ hóa đơn của khách này" FontSize="{StaticResource Tinix.FontSize.Small}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text=" ➔" FontSize="{StaticResource Tinix.FontSize.Small}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Primary}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ALIAS DIRECTORY MANAGEMENT -->
                    <Border Grid.Row="2" Background="{StaticResource Tinix.Color.Bg.Subtle}" CornerRadius="{StaticResource Tinix.Radius.Md}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header & Help Text -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="📁 QUẢN LÝ ALIAS THƯ MỤC TRÊN Ổ CỨNG" FontSize="{StaticResource Tinix.FontSize.Small}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}" Margin="0,0,0,3"/>
                                    <TextBlock Text="Các thư mục đơn hàng có tên trùng khớp với alias bên dưới sẽ được tự động nhận diện và gom về khách hàng này." FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Sm}" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedCustomer.Aliases.Count, StringFormat='{}{0} alias đã lưu'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                                </Border>
                            </Grid>

                            <!-- Empty State if no aliases -->
                            <Border Grid.Row="1" Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Md}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCustomer.Aliases.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📂 Chưa có alias thư mục nào cho khách hàng này." FontSize="{StaticResource Tinix.FontSize.Body}" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Secondary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Hãy nhập tên thư mục thường dùng khi chụp/in bên dưới để tự động gom đơn vào khách này." FontSize="{StaticResource Tinix.FontSize.Caption}" Foreground="{StaticResource Tinix.Color.Text.Muted}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Aliases List -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding SelectedCustomer.Aliases}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" Background="Transparent" Margin="0,0,0,12" Padding="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.Style>
                                    <Style TargetType="ListBox">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCustomer.Aliases.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type domain:CustomerAlias}">
                                        <Border Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="12,8" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="📁 " FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AliasText}" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center" FontFamily="{StaticResource Tinix.Font.Mono}" FontSize="{StaticResource Tinix.FontSize.Body}"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource Tinix.Button.Icon}" Margin="0,0,6,0" ToolTip="Sửa tên alias này" Click="EditAlias_Click">
                                                        <Path Width="13" Height="13" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                                                    </Button>
                                                    <Button Style="{StaticResource Tinix.Button.Icon.Danger}" ToolTip="Xóa alias này" Click="RemoveAlias_Click">
                                                        <Path Width="13" Height="13" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Add Alias Form -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,4">
                                <TextBlock Text="Thêm alias mới cho khách này:" FontSize="{StaticResource Tinix.FontSize.Small}" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewAliasText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tinix.TextBox.Standard}" Height="34"/>
                                    <Button Grid.Column="1" Command="{Binding AddAliasCommand}" Content="Thêm Alias" Margin="8,0,0,0" Style="{StaticResource Tinix.Button.Info}" Padding="16,0" Height="34"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Status -->
                    <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource Tinix.Color.Success}" FontWeight="SemiBold" FontSize="{StaticResource Tinix.FontSize.Caption}" Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
