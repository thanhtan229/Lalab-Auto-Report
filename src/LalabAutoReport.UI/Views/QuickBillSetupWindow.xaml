<Window x:Class="LalabAutoReport.UI.Views.QuickBillSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LalabAutoReport.UI.ViewModels"
        xmlns:domain="clr-namespace:LalabAutoReport.Core.Domain;assembly=LalabAutoReport.Core"
        xmlns:converters="clr-namespace:LalabAutoReport.UI.Converters"
        mc:Ignorable="d"
        Title="⚡ Quick Bill (Khách Lẻ)" Height="640" Width="760"
        MinHeight="520" MinWidth="650"
        Icon="../Resources/app.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Tinix.Font.UI}"
        Background="{StaticResource Tinix.Color.Bg.Body}">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Body Form -->
            <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Lg}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="20,16" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FEF3C7" CornerRadius="{StaticResource Tinix.Radius.Sm}" Padding="8,3" Margin="0,0,10,0">
                        <TextBlock Text="⚡ QUICK BILL" FontWeight="Bold" Foreground="#B45309" FontSize="11"/>
                    </Border>
                    <TextBlock Text="Tính Bill Khách Lẻ" FontFamily="{StaticResource Tinix.Font.Display}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                </StackPanel>
                <TextBlock Text="Lập và xuất hóa đơn nhanh từ một hoặc nhiều thư mục nguồn mà không thêm khách hàng vào hệ thống." 
                           Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="13" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- BODY FORM -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- SECTION 1: SOURCE FOLDERS -->
                <Border Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Lg}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="THƯ MỤC NGUỒN" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                                <TextBlock Text="Chọn các thư mục chứa ảnh/sản phẩm cần tính tiền (có thể chọn nhiều thư mục gộp lại)" FontSize="12" Foreground="{StaticResource Tinix.Color.Text.Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding AddFoldersCommand}" Content="+ Thêm Thư Mục..." Style="{StaticResource Tinix.Button.Secondary}" Padding="14,6"/>
                        </Grid>

                        <!-- Folders List -->
                        <Border Background="{StaticResource Tinix.Color.Bg.Subtle}" CornerRadius="{StaticResource Tinix.Radius.Md}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" MinHeight="100" Padding="8">
                            <Grid>
                                <!-- Empty state -->
                                <TextBlock Text="Chưa chọn thư mục nào. Nhấn '+ Thêm Thư Mục...' ở trên để bắt đầu." 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource Tinix.Color.Text.Muted}" FontSize="13"
                                           Visibility="{Binding HasFolders, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>

                                <!-- Items list -->
                                <ItemsControl ItemsSource="{Binding SourceFolders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Sm}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Margin="0,2" Padding="10,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="📁 " VerticalAlignment="Center" FontSize="14" Margin="0,0,6,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" FontFamily="{StaticResource Tinix.Font.Mono}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                                                    <Button Grid.Column="2" 
                                                            Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                            CommandParameter="{Binding}" 
                                                            Content="✕" Width="24" Height="24" 
                                                            Style="{StaticResource Tinix.Button.Ghost}" 
                                                            Padding="0" ToolTip="Xóa thư mục này"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: GUEST NAME -->
                <Border Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Lg}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="TÊN KHÁCH LẺ (HIỂN THỊ TRÊN BILL)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Tinix.Color.Text.Primary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Tên này sẽ được in trên phiếu tính tiền JPEG và dùng để nhận diện bill. Bạn có thể sửa trực tiếp:" FontSize="12" Foreground="{StaticResource Tinix.Color.Text.Muted}" Margin="0,0,0,10"/>
                        <TextBox Text="{Binding GuestName, UpdateSourceTrigger=PropertyChanged}" Height="38" FontSize="14" FontWeight="SemiBold" Style="{StaticResource Tinix.TextBox.Standard}"/>
                    </StackPanel>
                </Border>

                <!-- SECTION 3: DUPLICATE WARNING BANNER -->
                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1.5" CornerRadius="{StaticResource Tinix.Radius.Lg}" Padding="16" Visibility="{Binding HasDuplicateWarnings, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="⚠️ " FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="CẢNH BÁO: PHÁT HIỆN THƯ MỤC ĐÃ ĐƯỢC TÍNH BILL TRƯỚC ĐÂY" FontWeight="Bold" Foreground="#B45309" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Thư mục nguồn bên dưới đã từng nằm trong một hóa đơn đã Khóa hoặc đã Xuất ảnh. Vui lòng kiểm tra lại để tránh tính trùng tiền:" 
                                   Foreground="#92400E" FontSize="12" Margin="0,0,0,10"/>

                        <ItemsControl ItemsSource="{Binding DuplicateWarnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="{StaticResource Tinix.Radius.Md}" BorderBrush="#FCD34D" BorderThickness="1" Padding="12,10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FolderPath}" FontFamily="{StaticResource Tinix.Font.Mono}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="Đã tính trong: " FontSize="12" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                                                    <TextBlock Text="{Binding PreviousBillNumber}" FontWeight="Bold" FontFamily="{StaticResource Tinix.Font.Mono}" FontSize="12" Foreground="{StaticResource Tinix.Color.Primary}"/>
                                                    <TextBlock Text="{Binding PreviousBillDate, StringFormat='{}  •  Ngày: {0}'}" FontSize="12" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                                                    <TextBlock Text="{Binding PreviousBillGrandTotal, StringFormat='{}  •  {0:N0} đ'}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" 
                                                    Command="{Binding DataContext.OpenPreviousBillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                    CommandParameter="{Binding PreviousBillId}" 
                                                    Content="🔍 Mở Bill Cũ" Style="{StaticResource Tinix.Button.Secondary}" Padding="10,4" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER ACTIONS -->
        <Border Grid.Row="2" Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Lg}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status message -->
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>

                <!-- Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding CancelCommand}" Content="Hủy Bỏ" Height="38" Style="{StaticResource Tinix.Button.Secondary}" Padding="18,0" Margin="0,0,10,0"/>
                    <Button Command="{Binding CreateBillCommand}" Height="38" Style="{StaticResource Tinix.Button.Primary}" Padding="22,0" IsEnabled="{Binding HasFolders}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ " VerticalAlignment="Center"/>
                            <TextBlock Text="Quét &amp; Tạo Bill" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
