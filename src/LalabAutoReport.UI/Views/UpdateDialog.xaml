<Window x:Class="LalabAutoReport.UI.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LalabAutoReport.UI.ViewModels"
        mc:Ignorable="d"
        Title="Cập Nhật Ứng Dụng — Lalab Auto Report"
        Width="540" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{StaticResource Tinix.Font.UI}"
        Background="{StaticResource Tinix.Color.Bg.Body}">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="{StaticResource Tinix.Color.Bg.Surface}" Margin="16" CornerRadius="{StaticResource Tinix.Radius.Lg}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                        Background="{StaticResource Tinix.Color.Primary}"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="🚀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="CẬP NHẬT HỆ THỐNG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Primary}" Margin="0,0,0,2"/>
                    <TextBlock Text="Đã Có Bản Cập Nhật Mới!" FontFamily="{StaticResource Tinix.Font.Display}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Phiên bản hiện tại: " FontSize="12" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                        <TextBlock Text="{Binding UpdateInfo.CurrentVersion}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Muted}"/>
                        <TextBlock Text=" ➔ " FontSize="12" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Primary}" Margin="4,0"/>
                        <Border Background="{StaticResource Tinix.Color.Primary.Subtle}" CornerRadius="4" Padding="6,1" BorderBrush="{StaticResource Tinix.Color.Primary}" BorderThickness="0.5">
                            <TextBlock Text="{Binding UpdateInfo.LatestVersion}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Primary}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Release Notes Body -->
            <Border Grid.Row="1" Background="{StaticResource Tinix.Color.Bg.Subtle}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="14" Margin="0,0,0,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding UpdateInfo.ReleaseName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Tinix.Color.Text.Primary}" Margin="0,0,0,6"/>
                        <TextBlock Text="Nội dung cập nhật:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding UpdateInfo.ReleaseNotes}" FontSize="12" LineHeight="18" Foreground="{StaticResource Tinix.Color.Text.Primary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Actions / Progress -->
            <StackPanel Grid.Row="2">
                <!-- Idle State: Update Button -->
                <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource InverseBoolConverter}}">
                    <Button Command="{Binding StartUpdateCommand}"
                            Content="⚡ CẬP NHẬT NGAY VÀ KHỞI ĐỘNG LẠI"
                            Height="44"
                            Style="{StaticResource Tinix.Button.Primary}"
                            FontSize="13"
                            FontWeight="Bold"/>
                    <TextBlock Text="* Ứng dụng sẽ tự động tải bản mới và khởi động lại. Dữ liệu đơn hàng, bảng giá và khách hàng được bảo toàn tuyệt đối."
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="{StaticResource Tinix.Color.Text.Muted}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- Downloading State: Progress Bar -->
                <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ProgressText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" Margin="0,0,0,6"/>
                    <ProgressBar Height="10" Value="{Binding DownloadProgress}" Maximum="100" Margin="0,0,0,8"/>
                    <TextBlock Text="Vui lòng giữ ứng dụng mở. Ứng dụng sẽ tự động thay thế và khởi động lại sau khi tải xong."
                               FontSize="11"
                               Foreground="{StaticResource Tinix.Color.Text.Secondary}"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- Error Message if any -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource Tinix.Color.Danger}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
