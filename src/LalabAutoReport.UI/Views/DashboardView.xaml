<UserControl x:Class="LalabAutoReport.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LalabAutoReport.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource Tinix.Color.Bg.Body}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar / Date Navigation -->
            <RowDefinition Height="Auto"/> <!-- Summary Strip -->
            <RowDefinition Height="Auto"/> <!-- Filter & Search -->
            <RowDefinition Height="*"/>    <!-- Orders Content -->
            <RowDefinition Height="Auto"/> <!-- Footer / Status -->
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Date controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Ngày làm việc:" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13"/>
                    <Button Command="{Binding PreviousDayCommand}" Content="◀" Width="30" Height="34" Style="{StaticResource Tinix.Button.Secondary}" Padding="0" Margin="0,0,4,0"/>
                    <DatePicker SelectedDate="{Binding SelectedDate}" Height="34" Width="135" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                    <Button Command="{Binding NextDayCommand}" Content="▶" Width="30" Height="34" Style="{StaticResource Tinix.Button.Secondary}" Padding="0" Margin="0,0,6,0"/>
                    <Button Command="{Binding TodayCommand}" Content="Hôm nay" Height="34" Style="{StaticResource Tinix.Button.Secondary}" Padding="12,0"/>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ScanMissingDaysCommand}" Content="Quét ngày còn thiếu" Height="36" Style="{StaticResource Tinix.Button.Secondary}" Margin="0,0,8,0"/>
                    <Button Command="{Binding OpenDateFolderCommand}" Content="Mở thư mục ngày" Height="36" Style="{StaticResource Tinix.Button.Secondary}" Margin="0,0,10,0"/>
                    
                    <!-- Primary Call to Action: Tinix Orange -->
                    <Button Command="{Binding ScanDateCommand}" Height="36" Style="{StaticResource Tinix.Button.Primary}" Padding="22,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍 Quét Ngày" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CancelScanCommand}" Content="Hủy Quét" Height="36" Style="{StaticResource Tinix.Button.Danger}" Margin="8,0,0,0" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SUMMARY STRIP -->
        <Border Grid.Row="1" Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,0,0,1" Padding="20,12">
            <StackPanel Orientation="Horizontal">
                <Border Background="{StaticResource Tinix.Color.Bg.Subtle}" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="16,8" Margin="0,0,12,0" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tổng số đơn: " Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="13"/>
                        <TextBlock Text="{Binding TotalOrders}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontSize="13"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Tinix.Color.Bg.Subtle}" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="16,8" Margin="0,0,12,0" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Khách hàng: " Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="13"/>
                        <TextBlock Text="{Binding TotalCustomers}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Needs Review Badge Card -->
                <Border Background="{StaticResource Tinix.Color.Warning.Bg}" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="16,8" Margin="0,0,12,0" BorderBrush="{StaticResource Tinix.Color.Warning.Border}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cần xử lý: " Foreground="{StaticResource Tinix.Color.Warning}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding NeedsReviewCount}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Warning}" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Ready Badge Card -->
                <Border Background="{StaticResource Tinix.Color.Success.Bg}" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="16,8" Margin="0,0,12,0" BorderBrush="{StaticResource Tinix.Color.Success.Border}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sẵn sàng: " Foreground="{StaticResource Tinix.Color.Success}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding ReadyCount}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Success}" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Locked Badge Card -->
                <Border Background="{StaticResource Tinix.Color.Info.Bg}" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="16,8" Margin="0,0,12,0" BorderBrush="{StaticResource Tinix.Color.Info.Border}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Đã khóa: " Foreground="{StaticResource Tinix.Color.Info}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding LockedCount}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Info}" FontSize="13"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- FILTER & SEARCH -->
        <Border Grid.Row="2" Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Pill-like Filter Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="Tất cả" IsChecked="{Binding CurrentFilter, ConverterParameter=All, Mode=OneWay}" Click="FilterAll_Click" Margin="0,0,18,0" VerticalAlignment="Center" FontWeight="Normal" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                    <RadioButton Content="Cần xử lý (!)" IsChecked="{Binding CurrentFilter, ConverterParameter=NeedsReview, Mode=OneWay}" Click="FilterNeedsReview_Click" Foreground="{StaticResource Tinix.Color.Warning}" FontWeight="SemiBold" Margin="0,0,18,0" VerticalAlignment="Center"/>
                    <RadioButton Content="Sẵn sàng (✓)" IsChecked="{Binding CurrentFilter, ConverterParameter=Ready, Mode=OneWay}" Click="FilterReady_Click" Foreground="{StaticResource Tinix.Color.Success}" FontWeight="SemiBold" Margin="0,0,18,0" VerticalAlignment="Center"/>
                    <RadioButton Content="Đã khóa (🔒)" IsChecked="{Binding CurrentFilter, ConverterParameter=Locked, Mode=OneWay}" Click="FilterLocked_Click" Foreground="{StaticResource Tinix.Color.Info}" FontWeight="SemiBold" Margin="0,0,18,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search Box -->
                <TextBox Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" FontSize="12">
                    <TextBox.Resources>
                        <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                            <VisualBrush.Visual>
                                <TextBlock Text="🔍 Tìm kiếm khách, quy cách..." Foreground="{StaticResource Tinix.Color.Text.Muted}" Margin="8,0"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource Tinix.TextBox.Standard}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource CueBannerBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </Border>

        <!-- ORDERS CONTENT REGION (List or Empty State) -->
        <Grid Grid.Row="3">
            <!-- EMPTY STATE (Section 21.2) -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,40" MaxWidth="520">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOrders}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Lg}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="36,30">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📂" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <TextBlock Text="Chưa Có Dữ Liệu Đơn Hàng" FontFamily="{StaticResource Tinix.Font.Display}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Chưa có đơn hàng nào được ghi nhận cho ngày làm việc này, hoặc không có kết quả phù hợp với bộ lọc/tìm kiếm hiện tại." Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Command="{Binding ScanDateCommand}" Content="🔍 Quét Ngày Này" Height="38" Style="{StaticResource Tinix.Button.Primary}" Padding="20,0" Margin="0,0,10,0"/>
                            <Button Command="{Binding OpenDateFolderCommand}" Content="Mở Thư Mục Ngày" Height="38" Style="{StaticResource Tinix.Button.Secondary}" Padding="16,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ORDERS LIST -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOrders}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding FilteredOrders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OrderDisplayModel}">
                        <!-- Tinix Card Container -->
                        <Border Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Lg}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Margin="0,0,0,14" Padding="18">
                            <StackPanel>
                                <!-- Order Header -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Customer Folder Name & Status Pill Badge -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📁 " FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding OriginalFolderName}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center"/>
                                        
                                        <!-- Tinix Pill Status Badge -->
                                        <Border CornerRadius="{StaticResource Tinix.Radius.Full}" Padding="10,3" Margin="12,0,0,0" Background="{Binding StatusBadgeBg}" BorderBrush="{Binding StatusBadgeBorder}" BorderThickness="1">
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBadgeFg}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Summary Totals -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="Gốc: " Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="12"/>
                                        <TextBlock Text="{Binding TotalSourceCount}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}" Margin="0,0,12,0" FontSize="13"/>
                                        <TextBlock Text="In: " Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="12"/>
                                        <TextBlock Text="{Binding TotalPrintCount}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}" Margin="0,0,12,0" FontSize="13"/>
                                        <TextBlock Text="Tính tiền: " Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="12"/>
                                        <TextBlock Text="{Binding TotalBillQuantity}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Primary}" Margin="0,0,12,0" FontSize="13"/>
                                        <TextBlock Text="Thành tiền: " Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="12"/>
                                        <TextBlock Text="{Binding FormattedTotalAmount}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Success}" FontSize="13"/>
                                    </StackPanel>

                                    <!-- Order Actions -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="Khóa đơn" Height="30" Padding="12,0" Margin="0,0,6,0" Click="LockOrder_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Tinix.Button.Primary}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Mở khóa" Height="30" Padding="12,0" Margin="0,0,6,0" Click="ReopenOrder_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Tinix.Button.Danger}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Mở thư mục" Height="30" Padding="10,0" Margin="0,0,6,0" Style="{StaticResource Tinix.Button.Secondary}" Click="OpenOrderFolder_Click"/>
                                        <Button Content="Quét lại" Height="30" Padding="10,0" Style="{StaticResource Tinix.Button.Secondary}" Click="RescanOrder_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Items / Specifications Table -->
                                <Border Background="{StaticResource Tinix.Color.Bg.Subtle}" CornerRadius="{StaticResource Tinix.Radius.Md}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="10">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:OrderItemDisplayModel}">
                                                <Border BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,0,0,1" Padding="8,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Row info -->
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="190"/> <!-- Spec Name -->
                                                                <ColumnDefinition Width="80"/>  <!-- Source Count -->
                                                                <ColumnDefinition Width="80"/>  <!-- Print Count -->
                                                                <ColumnDefinition Width="90"/>  <!-- Difference -->
                                                                <ColumnDefinition Width="90"/>  <!-- Unit Price -->
                                                                <ColumnDefinition Width="100"/> <!-- Line Total -->
                                                                <ColumnDefinition Width="*"/>   <!-- Status & Resolution -->
                                                                <ColumnDefinition Width="Auto"/> <!-- Item Actions -->
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="{Binding SpecName}" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SpecName}"/>
                                                            
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="Gốc: " Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="11"/>
                                                                <TextBlock Text="{Binding SourceCount}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="In: " Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="11"/>
                                                                <TextBlock Text="{Binding PrintCount, TargetNullValue='--'}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                                                            </StackPanel>

                                                            <!-- Difference Tag Pill -->
                                                            <Border Grid.Column="3" CornerRadius="{StaticResource Tinix.Radius.Full}" Padding="8,2" HorizontalAlignment="Left" Background="{Binding StatusBadgeBg}" BorderBrush="{Binding StatusBadgeBorder}" BorderThickness="1">
                                                                <TextBlock Text="{Binding MismatchText}" Foreground="{Binding StatusBadgeFg}" FontSize="11" FontWeight="SemiBold"/>
                                                            </Border>

                                                            <!-- Unit Price -->
                                                            <TextBlock Grid.Column="4" Text="{Binding FormattedUnitPrice}" VerticalAlignment="Center" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="11"/>

                                                            <!-- Line Total -->
                                                            <TextBlock Grid.Column="5" Text="{Binding FormattedLineTotal}" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Success}" FontSize="11"/>

                                                            <!-- Status & Resolution -->
                                                            <TextBlock Grid.Column="6" Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="6,0" TextTrimming="CharacterEllipsis"/>

                                                            <!-- Spec actions -->
                                                            <StackPanel Grid.Column="7" Orientation="Horizontal">
                                                                <Button Content="Mở gốc" Height="28" Padding="10,0" Margin="0,0,4,0" Style="{StaticResource Tinix.Button.Secondary}" Click="OpenSourceFolder_Click"/>
                                                                <Button Content="Mở in" Height="28" Padding="10,0" Margin="0,0,4,0" Style="{StaticResource Tinix.Button.Secondary}" Click="OpenPrintFolder_Click" IsEnabled="{Binding SelectedPrintFolderRelativePath, TargetNullValue=false}"/>
                                                                <Button Content="Quét lại" Height="28" Padding="10,0" Style="{StaticResource Tinix.Button.Secondary}" Click="RescanSpec_Click"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Row resolution controls (shown when ambiguous or mismatch) -->
                                                        <StackPanel Grid.Row="1" Margin="190,8,0,0">
                                                            <!-- AMBIGUOUS LEAF FOLDERS -->
                                                            <StackPanel Visibility="{Binding IsAmbiguous, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="⚠️ Có nhiều nhánh thư mục in hợp lệ, vui lòng bấm chọn nhánh thực tế:" Foreground="{StaticResource Tinix.Color.Warning}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                                                <ItemsControl ItemsSource="{Binding CandidateFolders}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                                                <Button Content="Chọn nhánh này" Style="{StaticResource Tinix.Button.Primary}" Padding="10,4" Margin="0,0,8,0" FontSize="11" Click="SelectCandidateFolder_Click"/>
                                                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontFamily="Consolas" FontSize="12"/>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>

                                                            <!-- QUANTITY MISMATCH RESOLUTION -->
                                                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasMismatch, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                                                <TextBlock Text="Chọn số lượng tính tiền:" VerticalAlignment="Center" Foreground="{StaticResource Tinix.Color.Danger}" FontWeight="SemiBold" Margin="0,0,10,0" FontSize="12"/>
                                                                <Button Content="Dùng SL In" Style="{StaticResource Tinix.Button.Primary}" Padding="12,4" Margin="0,0,6,0" FontSize="11" Click="UsePrintQuantity_Click"/>
                                                                <Button Content="Dùng SL Gốc" Style="{StaticResource Tinix.Button.Secondary}" Padding="12,4" Margin="0,0,6,0" FontSize="11" Click="UseSourceQuantity_Click"/>
                                                                <Button Content="Tùy chỉnh..." Style="{StaticResource Tinix.Button.Ghost}" Padding="10,4" FontSize="11" Click="CustomQuantity_Click"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- FOOTER / STATUS BAR -->
        <Border Grid.Row="4" Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center" FontSize="12"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ScanProgressText}" Foreground="{StaticResource Tinix.Color.Primary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <ProgressBar Value="{Binding ScanProgressPercent}" Width="140" Height="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
