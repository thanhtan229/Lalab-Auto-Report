<UserControl x:Class="LalabAutoReport.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LalabAutoReport.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar / Date Navigation -->
            <RowDefinition Height="Auto"/> <!-- Summary Strip -->
            <RowDefinition Height="Auto"/> <!-- Filter & Search -->
            <RowDefinition Height="*"/>    <!-- Orders Content -->
            <RowDefinition Height="Auto"/> <!-- Footer / Status -->
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Date controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Ngày làm việc:" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Command="{Binding PreviousDayCommand}" Content="◀" Width="28" Height="32" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand"/>
                    <DatePicker SelectedDate="{Binding SelectedDate}" Height="32" Width="130" Margin="4,0" VerticalContentAlignment="Center"/>
                    <Button Command="{Binding NextDayCommand}" Content="▶" Width="28" Height="32" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand"/>
                    <Button Command="{Binding TodayCommand}" Content="Hôm nay" Height="32" Padding="10,0" Margin="6,0,0,0" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand"/>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ScanMissingDaysCommand}" Content="Quét ngày còn thiếu" Height="34" Padding="14,0" Margin="0,0,10,0" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand"/>
                    <Button Command="{Binding OpenDateFolderCommand}" Content="Mở thư mục ngày" Height="34" Padding="14,0" Margin="0,0,10,0" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand"/>
                    
                    <Button Command="{Binding ScanDateCommand}" Height="36" Padding="20,0" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍 Quét Ngày" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CancelScanCommand}" Content="Hủy" Height="36" Padding="12,0" Margin="6,0,0,0" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SUMMARY STRIP -->
        <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
            <StackPanel Orientation="Horizontal">
                <Border Background="White" CornerRadius="6" Padding="16,8" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tổng số đơn: " Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalOrders}" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="6" Padding="16,8" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Khách hàng: " Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalCustomers}" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="6" Padding="16,8" Margin="0,0,12,0" BorderBrush="#FED7AA" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cần xử lý: " Foreground="#EA580C" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding NeedsReviewCount}" FontWeight="Bold" Foreground="#EA580C"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="6" Padding="16,8" Margin="0,0,12,0" BorderBrush="#BBF7D0" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sẵn sàng: " Foreground="#16A34A" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ReadyCount}" FontWeight="Bold" Foreground="#16A34A"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="6" Padding="16,8" Margin="0,0,12,0" BorderBrush="#BFDBFE" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Đã khóa: " Foreground="#1D4ED8" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LockedCount}" FontWeight="Bold" Foreground="#1D4ED8"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- FILTER & SEARCH -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <RadioButton Content="Tất cả" IsChecked="{Binding CurrentFilter, ConverterParameter=All, Mode=OneWay}" Click="FilterAll_Click" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <RadioButton Content="Cần xử lý (!)" IsChecked="{Binding CurrentFilter, ConverterParameter=NeedsReview, Mode=OneWay}" Click="FilterNeedsReview_Click" Foreground="#EA580C" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <RadioButton Content="Sẵn sàng (✓)" IsChecked="{Binding CurrentFilter, ConverterParameter=Ready, Mode=OneWay}" Click="FilterReady_Click" Foreground="#16A34A" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <RadioButton Content="Đã khóa (🔒)" IsChecked="{Binding CurrentFilter, ConverterParameter=Locked, Mode=OneWay}" Click="FilterLocked_Click" Foreground="#1D4ED8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search Box -->
                <TextBox Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="8,4" VerticalContentAlignment="Center" FontSize="12">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Resources>
                                <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                    <VisualBrush.Visual>
                                        <TextBlock Text="🔍 Tìm kiếm khách, quy cách..." Foreground="#94A3B8" Margin="8,0"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource CueBannerBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </Border>

        <!-- ORDERS LIST -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="20">
            <ItemsControl ItemsSource="{Binding FilteredOrders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OrderDisplayModel}">
                        <Border Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,14" Padding="16">
                            <StackPanel>
                                <!-- Order Header -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Customer Folder Name -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📁 " FontSize="16"/>
                                        <TextBlock Text="{Binding OriginalFolderName}" FontWeight="Bold" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        
                                        <!-- Status Badge -->
                                        <Border CornerRadius="4" Padding="8,2" Margin="12,0,0,0" Background="{Binding StatusBadgeColor}">
                                            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Summary Totals -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Gốc: " Foreground="#64748B"/>
                                        <TextBlock Text="{Binding TotalSourceCount}" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,10,0"/>
                                        <TextBlock Text="In: " Foreground="#64748B"/>
                                        <TextBlock Text="{Binding TotalPrintCount}" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,10,0"/>
                                        <TextBlock Text="Tính tiền: " Foreground="#64748B"/>
                                        <TextBlock Text="{Binding TotalBillQuantity}" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,10,0"/>
                                        <TextBlock Text="Thành tiền: " Foreground="#64748B"/>
                                        <TextBlock Text="{Binding FormattedTotalAmount}" FontWeight="Bold" Foreground="#16A34A"/>
                                    </StackPanel>

                                    <!-- Order Actions -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="Khóa đơn" Height="28" Padding="10,0" Margin="0,0,6,0" Background="#16A34A" Foreground="White" BorderThickness="0" Click="LockOrder_Click" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Mở khóa" Height="28" Padding="10,0" Margin="0,0,6,0" Background="#DC2626" Foreground="White" BorderThickness="0" Click="ReopenOrder_Click" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Mở thư mục" Height="28" Padding="10,0" Margin="0,0,6,0" Background="#F1F5F9" BorderBrush="#CBD5E1" Click="OpenOrderFolder_Click" Cursor="Hand"/>
                                        <Button Content="Quét lại đơn" Height="28" Padding="10,0" Background="#F1F5F9" BorderBrush="#CBD5E1" Click="RescanOrder_Click" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Items / Specifications Table -->
                                <Border Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:OrderItemDisplayModel}">
                                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="6,8">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Row info -->
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="190"/> <!-- Spec Name -->
                                                                <ColumnDefinition Width="80"/>  <!-- Source Count -->
                                                                <ColumnDefinition Width="80"/>  <!-- Print Count -->
                                                                <ColumnDefinition Width="90"/>  <!-- Difference -->
                                                                <ColumnDefinition Width="90"/>  <!-- Unit Price -->
                                                                <ColumnDefinition Width="100"/> <!-- Line Total -->
                                                                <ColumnDefinition Width="*"/>   <!-- Status & Resolution -->
                                                                <ColumnDefinition Width="Auto"/> <!-- Item Actions -->
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="{Binding SpecName}" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                            
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="Gốc: " Foreground="#64748B" FontSize="11"/>
                                                                <TextBlock Text="{Binding SourceCount}" FontWeight="Bold"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="In: " Foreground="#64748B" FontSize="11"/>
                                                                <TextBlock Text="{Binding PrintCount, TargetNullValue='--'}" FontWeight="Bold"/>
                                                            </StackPanel>

                                                            <!-- Difference Tag -->
                                                            <Border Grid.Column="3" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Background="{Binding StatusBadgeColor}">
                                                                <TextBlock Text="{Binding MismatchText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                                            </Border>

                                                            <!-- Unit Price -->
                                                            <TextBlock Grid.Column="4" Text="{Binding FormattedUnitPrice}" VerticalAlignment="Center" Foreground="#64748B" FontSize="11"/>

                                                            <!-- Line Total -->
                                                            <TextBlock Grid.Column="5" Text="{Binding FormattedLineTotal}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#16A34A" FontSize="11"/>

                                                            <!-- Status & Resolution -->
                                                            <TextBlock Grid.Column="6" Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#475569" Margin="6,0"/>

                                                            <!-- Spec actions -->
                                                            <StackPanel Grid.Column="7" Orientation="Horizontal">
                                                                <Button Content="Mở gốc" Height="26" Padding="8,0" Margin="0,0,4,0" Background="White" BorderBrush="#CBD5E1" Click="OpenSourceFolder_Click" Cursor="Hand"/>
                                                                <Button Content="Mở in" Height="26" Padding="8,0" Margin="0,0,4,0" Background="White" BorderBrush="#CBD5E1" Click="OpenPrintFolder_Click" IsEnabled="{Binding SelectedPrintFolderRelativePath, TargetNullValue=false}" Cursor="Hand"/>
                                                                <Button Content="Quét lại" Height="26" Padding="8,0" Background="White" BorderBrush="#CBD5E1" Click="RescanSpec_Click" Cursor="Hand"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Row resolution controls (shown when ambiguous or mismatch) -->
                                                        <StackPanel Grid.Row="1" Margin="220,6,0,0">
                                                            <!-- AMBIGUOUS LEAF FOLDERS -->
                                                            <StackPanel Visibility="{Binding IsAmbiguous, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="⚠️ Có nhiều nhánh thư mục in hợp lệ, vui lòng bấm chọn nhánh thực tế:" Foreground="#EA580C" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                                                <ItemsControl ItemsSource="{Binding CandidateFolders}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                                <Button Content="Chọn nhánh này" Padding="8,2" Margin="0,0,8,0" Background="#0284C7" Foreground="White" BorderThickness="0" Click="SelectCandidateFolder_Click" Cursor="Hand"/>
                                                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#1E293B" FontFamily="Consolas"/>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>

                                                            <!-- QUANTITY MISMATCH RESOLUTION -->
                                                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasMismatch, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                                                <TextBlock Text="Chọn số lượng tính tiền:" VerticalAlignment="Center" Foreground="#B91C1C" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                                <Button Content="Dùng SL In" Padding="10,3" Margin="0,0,6,0" Background="#0284C7" Foreground="White" BorderThickness="0" Click="UsePrintQuantity_Click" Cursor="Hand"/>
                                                                <Button Content="Dùng SL Gốc" Padding="10,3" Margin="0,0,6,0" Background="#475569" Foreground="White" BorderThickness="0" Click="UseSourceQuantity_Click" Cursor="Hand"/>
                                                                <Button Content="Tùy chỉnh..." Padding="10,3" Background="#64748B" Foreground="White" BorderThickness="0" Click="CustomQuantity_Click" Cursor="Hand"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- FOOTER / STATUS BAR -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#1E293B" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ScanProgressText}" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ProgressBar Value="{Binding ScanProgressPercent}" Width="120" Height="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
