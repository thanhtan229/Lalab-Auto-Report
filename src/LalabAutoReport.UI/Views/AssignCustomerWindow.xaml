<Window x:Class="LalabAutoReport.UI.Views.AssignCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LalabAutoReport.UI.ViewModels"
        xmlns:domain="clr-namespace:LalabAutoReport.Core.Domain;assembly=LalabAutoReport.Core"
        mc:Ignorable="d"
        Title="Gán Khách Hàng Cho Thư Mục" Height="650" Width="560"
        MinHeight="540" MinWidth="480"
        Icon="../Resources/app.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Tinix.Font.UI}"
        Background="{StaticResource Tinix.Color.Bg.Body}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Guest & Suggestions -->
            <RowDefinition Height="*"/>    <!-- Customer List & Search -->
            <RowDefinition Height="Auto"/> <!-- Quick Create -->
            <RowDefinition Height="Auto"/> <!-- Alias Checkbox -->
            <RowDefinition Height="Auto"/> <!-- Status & Actions -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <Border Grid.Row="0" Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Lg}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#E0F2FE" CornerRadius="{StaticResource Tinix.Radius.Full}" Padding="8,2" Margin="0,0,8,0">
                            <TextBlock Text="GÁN KHÁCH HÀNG" FontWeight="Bold" Foreground="#0369A1" FontSize="10"/>
                        </Border>
                        <TextBlock Text="{Binding WorkDate, StringFormat='{}Ngày: {0}'}" FontSize="12" Foreground="{StaticResource Tinix.Color.Text.Muted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁 Thư mục: " FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                        <TextBlock Text="{Binding FolderName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding AssignAsGuestCommand}" Style="{StaticResource Tinix.Button.Secondary}" Height="34" Padding="12,0" VerticalAlignment="Center" ToolTip="Đánh dấu đơn hàng này là Khách lẻ, không lưu vào danh sách khách quen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡ " Foreground="#B45309" FontWeight="Bold"/>
                        <TextBlock Text="Đặt Là Khách Lẻ" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 2. FUZZY SUGGESTIONS (if any) -->
        <Border Grid.Row="1" Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Md}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding Suggestions.Count, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Gợi ý khớp tên gần đúng nhất:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Suggestions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CustomerSuggestionItem}">
                            <Button Command="{Binding DataContext.SelectSuggestionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Customer}"
                                    Style="{StaticResource Tinix.Button.Ghost}"
                                    Margin="0,0,8,4" Padding="10,4" Height="28" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1">
                                <TextBlock Text="{Binding DisplayText}" Foreground="#15803D" FontWeight="Bold" FontSize="11"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 3. CUSTOMER SEARCH & LIST -->
        <Border Grid.Row="2" Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Lg}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search Input -->
                <TextBox Grid.Row="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,0,8">
                    <TextBox.Resources>
                        <VisualBrush x:Key="CueSearch" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                            <VisualBrush.Visual>
                                <TextBlock Text="🔍 Tìm theo tên khách hàng, số điện thoại hoặc alias..." Foreground="{StaticResource Tinix.Color.Text.Muted}" Margin="8,0" FontSize="12"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource Tinix.TextBox.Standard}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource CueSearch}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Customer ListBox -->
                <ListBox Grid.Row="1" ItemsSource="{Binding FilteredCustomers}" SelectedItem="{Binding SelectedCustomer}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="{StaticResource Tinix.Color.Bg.Subtle}" CornerRadius="{StaticResource Tinix.Radius.Md}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="12,8" SnapsToDevicePixels="True" Cursor="Hand">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Tinix.Color.Primary}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Tinix.Color.Primary.Subtle}"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Tinix.Color.Primary}"/>
                                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type domain:Customer}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding CanonicalName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Aliases.Count, StringFormat='{}Biệt danh: {0}'}" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                                        <TextBlock Text="{Binding Phone, StringFormat='{} • SĐT: {0}'}" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Secondary}"
                                                   Visibility="{Binding Phone, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="✓ Đang chọn" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Primary}" FontSize="11" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 4. QUICK CREATE NEW CUSTOMER -->
        <Border Grid.Row="3" Background="{StaticResource Tinix.Color.Bg.Subtle}" CornerRadius="{StaticResource Tinix.Radius.Md}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,6,0">
                    <TextBox.Resources>
                        <VisualBrush x:Key="CueNewCust" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                            <VisualBrush.Visual>
                                <TextBlock Text="+ Tên khách mới..." Foreground="{StaticResource Tinix.Color.Text.Muted}" Margin="6,0" FontSize="11"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource Tinix.TextBox.Standard}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource CueNewCust}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBox Grid.Column="1" Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,6,0">
                    <TextBox.Resources>
                        <VisualBrush x:Key="CueNewPhone" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                            <VisualBrush.Visual>
                                <TextBlock Text="Số điện thoại..." Foreground="{StaticResource Tinix.Color.Text.Muted}" Margin="6,0" FontSize="11"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource Tinix.TextBox.Standard}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource CueNewPhone}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button Grid.Column="2" Command="{Binding QuickCreateCustomerCommand}" Content="Thêm Nhanh" Style="{StaticResource Tinix.Button.Secondary}" Height="30" Padding="12,0"/>
            </Grid>
        </Border>

        <!-- 5. ALIAS PERMANENT CHECKBOX -->
        <CheckBox Grid.Row="4" IsChecked="{Binding SaveAliasPermanently}" Margin="4,0,0,10" VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Tự động lưu " FontSize="12" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                <TextBlock Text="{Binding FolderName, StringFormat='{}&quot;{0}&quot;'}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Tinix.Color.Primary}"/>
                <TextBlock Text=" làm Alias vĩnh viễn (các lần quét sau sẽ tự động nhận diện)" FontSize="12" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
            </StackPanel>
        </CheckBox>

        <!-- 6. STATUS MESSAGE & BOTTOM ACTIONS -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{StaticResource Tinix.Color.Primary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

            <Button Grid.Column="1" Command="{Binding CancelCommand}" Content="Hủy Bỏ" Style="{StaticResource Tinix.Button.Secondary}" Width="90" Height="36" Margin="0,0,8,0" IsCancel="True"/>
            <Button Grid.Column="2" Command="{Binding ConfirmAssignCommand}" Content="✓ Xác Nhận Gán" Style="{StaticResource Tinix.Button.Primary}" Width="130" Height="36" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
