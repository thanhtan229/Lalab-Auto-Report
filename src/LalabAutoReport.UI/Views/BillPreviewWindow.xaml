<Window x:Class="LalabAutoReport.UI.Views.BillPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xem Trước Hóa Đơn"
        Width="780"
        Height="880"
        MinWidth="600"
        MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Icon="../Resources/app.ico"
        FontFamily="{StaticResource Tinix.Font.UI}"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown">
    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Preview Image Container -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons & Status -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="0,0,0,10" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="📄" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="txtTitle" Text="Hóa đơn" FontWeight="Bold" FontSize="15" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                    </StackPanel>
                    <TextBlock x:Name="txtSubtitle" Text="Kỳ thanh toán • Tổng tiền" FontSize="12" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Right controls: Zoom Mode Buttons + Pagination controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Zoom Mode Segment -->
                    <Border Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Sm}" Padding="3" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="radFitPage" Content="📐 Vừa khung" GroupName="ViewMode" IsChecked="True" Style="{StaticResource Tinix.FilterPill}" Height="28" Padding="10,0" Margin="0,0,4,0" Click="FitPage_Click" ToolTip="Hiển thị vừa vặn toàn bộ trang hóa đơn từ đầu đến chân (không cần cuộn)"/>
                            <RadioButton x:Name="radFitWidth" Content="↔️ Vừa chiều rộng" GroupName="ViewMode" Style="{StaticResource Tinix.FilterPill}" Height="28" Padding="10,0" Margin="0,0,4,0" Click="FitWidth_Click" ToolTip="Phóng to theo chiều ngang cửa sổ để đọc chữ to hơn (cuộn dọc xem tiếp)"/>
                            <RadioButton x:Name="radActualSize" Content="🔍 100%" GroupName="ViewMode" Style="{StaticResource Tinix.FilterPill}" Height="28" Padding="10,0" Margin="0" Click="ActualSize_Click" ToolTip="Kích thước gốc thực tế (1080px)"/>
                        </StackPanel>
                    </Border>

                    <!-- Pagination controls for multi-page bills -->
                    <StackPanel x:Name="pnlPagination" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <Button x:Name="btnPrevPage" Content="◀ Trước" Style="{StaticResource Tinix.Button.Secondary}" Height="30" Padding="8,0" Margin="0,0,6,0" Click="PrevPage_Click"/>
                        <Border Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Sm}" Padding="8,4" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtPageInfo" Text="Trang 1 / 1" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                        </Border>
                        <Button x:Name="btnNextPage" Content="Sau ▶" Style="{StaticResource Tinix.Button.Secondary}" Height="30" Padding="8,0" Click="NextPage_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Preview Image Container -->
        <Border Grid.Row="1" x:Name="previewContainer" Background="#F1F5F9" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="12" Margin="0,0,0,12" SizeChanged="PreviewContainer_SizeChanged">
            <ScrollViewer x:Name="scrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          Focusable="False"
                          PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                <Border x:Name="borderImagePaper"
                        Background="White"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        ToolTip="Nhấp đúp chuột để chuyển đổi Vừa khung / Vừa chiều rộng (hoặc giữ Ctrl + lăn chuột để phóng to/thu nhỏ)"
                        MouseLeftButtonDown="BorderImagePaper_MouseLeftButtonDown">
                    <Border.Effect>
                        <DropShadowEffect Color="#64748B" BlurRadius="14" ShadowDepth="3" Opacity="0.3"/>
                    </Border.Effect>
                    <Image x:Name="imgPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0"/>
                </Border>
            </ScrollViewer>
        </Border>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Bottom-left: Buộc xuất lại -->
                <ColumnDefinition Width="*"/>    <!-- Status message -->
                <ColumnDefinition Width="Auto"/> <!-- Bottom-right: Action buttons -->
            </Grid.ColumnDefinitions>

            <!-- Bottom-left action: Buộc xuất lại -->
            <Button Grid.Column="0" x:Name="btnForceReexport"
                    Content="⚡ Buộc xuất lại"
                    Height="36"
                    Style="{StaticResource Tinix.Button.Secondary}"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Click="ForceReexport_Click"
                    ToolTip="Render lại toàn bộ ảnh JPEG và Excel mới kể cả khi số liệu không thay đổi"/>

            <!-- Status message -->
            <TextBlock x:Name="txtStatus" Grid.Column="1"
                       Text="Nhấn 'Sao chép ảnh' để gửi nhanh qua Zalo/Messenger."
                       FontSize="12"
                       Foreground="{StaticResource Tinix.Color.Text.Secondary}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,12,0"/>

            <!-- Buttons on the right -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="btnCopyStitched" Content="📋 Ghép tất cả trang để copy" Height="36" Style="{StaticResource Tinix.Button.Secondary}" Margin="0,0,8,0" Visibility="Collapsed" Click="CopyStitched_Click" ToolTip="Ghép nối tất cả các trang thành 1 bức ảnh dài duy nhất rồi sao chép vào Clipboard"/>
                <Button x:Name="btnCopy" Content="📋 Sao chép ảnh (Ctrl+C)" Height="36" Style="{StaticResource Tinix.Button.Primary}" Margin="0,0,8,0" Click="CopyCurrentPage_Click" ToolTip="Sao chép trang hóa đơn này vào bộ nhớ tạm để dán (Ctrl+V) sang Zalo/chat"/>
                <Button x:Name="btnSave" Content="💾 Lưu ảnh..." Height="36" Style="{StaticResource Tinix.Button.Secondary}" Margin="0,0,8,0" Click="SaveImage_Click" ToolTip="Lưu tệp hình ảnh JPEG ra ổ đĩa máy tính"/>
                <Button x:Name="btnPrint" Content="🖨️ In bill" Height="36" Style="{StaticResource Tinix.Button.Secondary}" Margin="0,0,8,0" Click="Print_Click" ToolTip="In hóa đơn này ra máy in"/>
                <Button Content="Đóng" Width="80" Height="36" Style="{StaticResource Tinix.Button.Secondary}" Click="Close_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
