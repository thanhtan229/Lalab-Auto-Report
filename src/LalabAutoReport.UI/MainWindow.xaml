<Window x:Class="LalabAutoReport.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LalabAutoReport.UI.ViewModels"
        xmlns:views="clr-namespace:LalabAutoReport.UI.Views"
        mc:Ignorable="d"
        Title="Lalab Auto Report — Quản Lý In &amp; Báo Cáo" Height="780" Width="1240"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Tinix.Font.UI}"
        Background="{StaticResource Tinix.Color.Bg.Body}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <views:CustomersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PriceListViewModel}">
            <views:PriceListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

        <!-- Sidebar Item Style -->
        <Style x:Key="TinixNavItemStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="navBorder" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="12,0" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="activeIndicator" Grid.Column="0" Width="3" Height="20" Background="{StaticResource Tinix.Color.Primary}" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-6,0,8,0" Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource Tinix.Color.Border.Subtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR (Tinix Warm Light Profile) -->
        <Border Grid.Column="0" Background="{StaticResource Tinix.Color.Bg.Sidebar}" BorderBrush="{StaticResource Tinix.Color.Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Brand -->
                <StackPanel Grid.Row="0" Margin="20,24,20,24">
                    <TextBlock Text="TINIX WORKSHOP" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Primary}" Margin="0,0,0,4"/>
                    <TextBlock Text="LALAB REPORT" FontFamily="{StaticResource Tinix.Font.Display}" FontWeight="Bold" FontSize="20" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                    <TextBlock Text="Quản lý in &amp; đối soát ảnh" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Navigation items -->
                <StackPanel Grid.Row="1" Margin="12,0">
                    <Button Command="{Binding NavigateToDashboardCommand}" Style="{StaticResource TinixNavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Quét &amp; Đơn hàng" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToReportsCommand}" Style="{StaticResource TinixNavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊 " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Báo cáo doanh thu" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToCustomersCommand}" Style="{StaticResource TinixNavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥 " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Khách hàng &amp; Alias" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToPriceListCommand}" Style="{StaticResource TinixNavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏷️ " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Bảng giá quy cách" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToSettingsCommand}" Style="{StaticResource TinixNavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️ " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Cài đặt hệ thống" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer version -->
                <Border Grid.Row="2" Padding="20,16" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="Lalab Auto Report v1.0" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Text="Tinix Light Standard" Foreground="{StaticResource Tinix.Color.Text.Muted}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Root warning banner -->
                <RowDefinition Height="*"/>    <!-- Current view -->
            </Grid.RowDefinitions>

            <!-- Root Folder Warning Banner (Tinix Amber Alert) -->
            <Border Grid.Row="0" Background="{StaticResource Tinix.Color.Warning.Bg}" BorderBrush="{StaticResource Tinix.Color.Warning.Border}" BorderThickness="0,0,0,1" Padding="18,12" Visibility="{Binding HasRootFolderWarning, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚠️ " FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="Chưa cấu hình Thư Mục Gốc (Root Folder) hoặc đường dẫn không hợp lệ. Vui lòng cài đặt trước khi quét." Foreground="{StaticResource Tinix.Color.Warning}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding NavigateToSettingsCommand}" Content="Cài Đặt Ngay" Style="{StaticResource Tinix.Button.Primary}" Padding="14,6" FontSize="12"/>
                </Grid>
            </Border>

            <!-- Active View Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>
