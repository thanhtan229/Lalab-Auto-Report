<Window x:Class="LalabAutoReport.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LalabAutoReport.UI.ViewModels"
        xmlns:views="clr-namespace:LalabAutoReport.UI.Views"
        mc:Ignorable="d"
        Title="Lalab Auto Report v1.0 — Quản Lý In &amp; Báo Cáo" Height="780" Width="1240"
        MinHeight="600" MinWidth="950"
        Icon="Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Tinix.Font.UI}"
        Background="{StaticResource Tinix.Color.Bg.Body}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <views:CustomersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PriceListViewModel}">
            <views:PriceListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR (Tinix Warm Light Profile) -->
        <Border Grid.Column="0" Background="{StaticResource Tinix.Color.Bg.Sidebar}" BorderBrush="{StaticResource Tinix.Color.Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Brand (Studio Pro Upgrade) -->
                <Grid Grid.Row="0" Margin="16,22,16,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Icon (Squircle with Vector Glyph) -->
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                            Background="{StaticResource Tinix.Color.Primary}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White" Data="M19,8H5C3.34,8,2,9.34,2,11v6h4v4h12v-4h4v-6C22,9.34,20.66,8,19,8z M16,19H8v-5h8V19z M19,12c-0.55,0-1-0.45-1-1s0.45-1,1-1s1,0.45,1,1S19.55,12,19,12z M18,3H6v4h12V3z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <!-- App Title & Tagline -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="LALAB"
                                       FontFamily="{StaticResource Tinix.Font.UI}"
                                       FontWeight="ExtraBold"
                                       FontSize="17"
                                       Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                            <TextBlock Text="REPORT"
                                       FontFamily="{StaticResource Tinix.Font.UI}"
                                       FontWeight="SemiBold"
                                       FontSize="17"
                                       Foreground="{StaticResource Tinix.Color.Text.Secondary}"
                                       Margin="4,0,6,0"/>
                            <Border Background="{StaticResource Tinix.Color.Primary.Subtle}"
                                    CornerRadius="3"
                                    Padding="4,1"
                                    VerticalAlignment="Center"
                                    BorderBrush="{StaticResource Tinix.Color.Primary}"
                                    BorderThickness="0.5">
                                <TextBlock Text="PRO"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Tinix.Color.Primary}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                            <Border Background="{StaticResource Tinix.Color.Bg.Subtle}"
                                    BorderBrush="{StaticResource Tinix.Color.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="4,1"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="v1.0"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Tinix.Color.Primary}"/>
                            </Border>
                            <TextBlock Text="Quản lý in &amp; đối soát ảnh"
                                       Foreground="{StaticResource Tinix.Color.Text.Secondary}"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Navigation items -->
                <StackPanel Grid.Row="1" Margin="10,0">
                    <RadioButton GroupName="MainSidebarTabs"
                                 Tag="📋"
                                 Content="ĐƠN HÀNG"
                                 IsChecked="{Binding IsDashboardActive}"
                                 Command="{Binding NavigateToDashboardCommand}"
                                 Style="{StaticResource Tinix.Sidebar.NavTab}"/>

                    <RadioButton GroupName="MainSidebarTabs"
                                 Tag="👥"
                                 Content="KHÁCH HÀNG"
                                 IsChecked="{Binding IsCustomersActive}"
                                 Command="{Binding NavigateToCustomersCommand}"
                                 Style="{StaticResource Tinix.Sidebar.NavTab}"/>

                    <RadioButton GroupName="MainSidebarTabs"
                                 Tag="🏷️"
                                 Content="BẢNG GIÁ"
                                 IsChecked="{Binding IsPriceListActive}"
                                 Command="{Binding NavigateToPriceListCommand}"
                                 Style="{StaticResource Tinix.Sidebar.NavTab}"/>

                    <RadioButton GroupName="MainSidebarTabs"
                                 Tag="📊"
                                 Content="BÁO CÁO"
                                 IsChecked="{Binding IsReportsActive}"
                                 Command="{Binding NavigateToReportsCommand}"
                                 Style="{StaticResource Tinix.Sidebar.NavTab}"/>

                    <RadioButton GroupName="MainSidebarTabs"
                                 Tag="⚙️"
                                 Content="CÀI ĐẶT"
                                 IsChecked="{Binding IsSettingsActive}"
                                 Command="{Binding NavigateToSettingsCommand}"
                                 Style="{StaticResource Tinix.Sidebar.NavTab}"/>
                </StackPanel>

                <!-- Footer version -->
                <Border Grid.Row="2" Padding="20,16" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="Lalab Auto Report v1.0" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Text="Tinix Light Standard" Foreground="{StaticResource Tinix.Color.Text.Muted}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Root warning banner -->
                <RowDefinition Height="*"/>    <!-- Current view -->
            </Grid.RowDefinitions>

            <!-- Root Folder Warning Banner (Tinix Amber Alert) -->
            <Border Grid.Row="0" Background="{StaticResource Tinix.Color.Warning.Bg}" BorderBrush="{StaticResource Tinix.Color.Warning.Border}" BorderThickness="0,0,0,1" Padding="18,12" Visibility="{Binding HasRootFolderWarning, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚠️ " FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="Chưa cấu hình Thư Mục Gốc (Root Folder) hoặc đường dẫn không hợp lệ. Vui lòng cài đặt trước khi quét." Foreground="{StaticResource Tinix.Color.Warning}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding NavigateToSettingsCommand}" Content="Cài Đặt Ngay" Style="{StaticResource Tinix.Button.Primary}" Padding="14,6" FontSize="12"/>
                </Grid>
            </Border>

            <!-- Active View Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>
